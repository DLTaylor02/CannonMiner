# For an existing installation, set these to the database containing the
# original segment_* tables before running setup.sh.
DATABASE_URL=pgsql:host=127.0.0.1;port=5432;dbname=cannonminer
DATABASE_USER=cannonminer
DATABASE_PASSWORD=replace_with_database_password
# Comma-separated proxy IPs allowed to supply X-Forwarded-For. Leave empty when
# clients connect directly or when the immediate reverse proxy is not trusted.
TRUSTED_PROXIES=
APP_ENV=production
