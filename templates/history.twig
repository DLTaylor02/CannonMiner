{% extends 'layout.twig' %}{% block title %}Calculated Runs | CannonMiner{% endblock %}{% block content %}
<section class="page-head"><div><p class="kicker">Analysis archive</p><h1>Calculated Runs</h1></div><p>Filter previous calculations and organize them by the metric that matters.</p></section>
<form method="get" class="history-filter"><input type="hidden" name="sort" value="{{ sort }}"><input type="hidden" name="dir" value="{{ direction }}"><label>Calculation type<select name="type" onchange="this.form.submit()"><option value="all" {{ filter=='all'?'selected':'' }}>All</option><option value="best" {{ filter=='best'?'selected':'' }}>Best Departure</option><option value="custom" {{ filter=='custom'?'selected':'' }}>Custom Route</option><option value="automated" {{ filter=='automated'?'selected':'' }}>Automated</option></select></label><label>User<select name="user" onchange="this.form.submit()"><option value="0">All users</option>{% for item in users %}<option value="{{ item.id }}" {{ selected_user==item.id?'selected':'' }}>{{ item.username }}</option>{% endfor %}</select></label><label>Results per page<select name="per_page" onchange="this.form.submit()">{% for size in ['20','40','60','80','all'] %}<option value="{{ size }}" {{ per_page==size?'selected':'' }}>{{ size=='all'?'All':size }}</option>{% endfor %}</select></label><label class="check"><input type="hidden" name="grouped" value="0"><input type="checkbox" name="grouped" value="1" {{ grouped?'checked':'' }} onchange="this.form.submit()"><span>Group matching results</span></label><a href="/history">Clear filters</a></form>
{% set history_state='type='~filter~'&user='~selected_user~'&per_page='~per_page~'&grouped='~(grouped?'1':'0') %}<div class="mobile-history-sort" role="group" aria-labelledby="mobile-sort-label"><strong id="mobile-sort-label">Organize by</strong><div><a class="{{ sort=='risk'?'active':'' }}" href="?{{ history_state }}&amp;sort=risk&amp;dir={{ sort=='risk' and direction=='asc'?'desc':'asc' }}">Risk {% if sort=='risk' %}{% if direction=='asc' %}&uarr;{% else %}&darr;{% endif %}{% else %}&#8597;{% endif %}</a><a class="{{ sort=='expected'?'active':'' }}" href="?{{ history_state }}&amp;sort=expected&amp;dir={{ sort=='expected' and direction=='asc'?'desc':'asc' }}">Expected time {% if sort=='expected' %}{% if direction=='asc' %}&uarr;{% else %}&darr;{% endif %}{% else %}&#8597;{% endif %}</a><a class="{{ sort=='run'?'active':'' }}" href="?{{ history_state }}&amp;sort=run&amp;dir={{ sort=='run' and direction=='desc'?'asc':'desc' }}">Run {% if sort=='run' %}{% if direction=='asc' %}&uarr;{% else %}&darr;{% endif %}{% else %}&#8597;{% endif %}</a><a class="{{ sort=='matches'?'active':'' }}" href="?{{ history_state }}&amp;sort=matches&amp;dir={{ sort=='matches' and direction=='desc'?'asc':'desc' }}">Matches {% if sort=='matches' %}{% if direction=='asc' %}&uarr;{% else %}&darr;{% endif %}{% else %}&#8597;{% endif %}</a></div></div>
<div class="table-wrap"><table><thead><tr><th>Type</th><th>Requested by</th><th>Run <a class="sort-arrow {{ sort=='run'?'active':'' }}" href="?{{ history_state }}&amp;sort=run&amp;dir={{ sort=='run'?(direction=='asc'?'desc':'asc'):'desc' }}" title="Sort by run time" aria-label="Sort by run time">{% if sort=='run' %}{% if direction=='asc' %}&uarr;{% else %}&darr;{% endif %}{% else %}&#8597;{% endif %}</a></th><th>Route</th><th>Strategy</th><th>Target avg speed</th><th>Recommended departure</th><th>Risk <a class="sort-arrow {{ sort=='risk'?'active':'' }}" href="?{{ history_state }}&amp;sort=risk&amp;dir={{ sort=='risk' and direction=='asc'?'desc':'asc' }}" title="Sort by risk" aria-label="Sort by risk">{% if sort=='risk' %}{% if direction=='asc' %}&uarr;{% else %}&darr;{% endif %}{% else %}&#8597;{% endif %}</a></th><th>Expected time <a class="sort-arrow {{ sort=='expected'?'active':'' }}" href="?{{ history_state }}&amp;sort=expected&amp;dir={{ sort=='expected' and direction=='asc'?'desc':'asc' }}" title="Sort by expected time" aria-label="Sort by expected time">{% if sort=='expected' %}{% if direction=='asc' %}&uarr;{% else %}&darr;{% endif %}{% else %}&#8597;{% endif %}</a></th><th>Matches <a class="sort-arrow {{ sort=='matches'?'active':'' }}" href="?{{ history_state }}&amp;sort=matches&amp;dir={{ sort=='matches' and direction=='desc'?'asc':'desc' }}" title="Sort by matching calculations" aria-label="Sort by matching calculations">{% if sort=='matches' %}{% if direction=='asc' %}&uarr;{% else %}&darr;{% endif %}{% else %}&#8597;{% endif %}</a></th><th></th></tr></thead><tbody>
{% for run in runs %}<tr><td>{% if run.job_type=='best' %}<span class="history-symbol" role="img" aria-label="Best Departure" title="Best Departure">&#9678;</span>{% elseif run.job_type=='custom' %}<span class="history-symbol" role="img" aria-label="Custom Route" title="Custom Route">&#9998;</span>{% else %}<span class="history-symbol" role="img" aria-label="Automated" title="Automated">&#9881;</span>{% endif %}</td><td>{{ run.username }}</td><td><a href="/analysis/{{ run.id }}"><time class="browser-time" datetime="{{ run.created_at|date('c') }}">{{ run.created_at|date('Y-m-d H:i T') }}</time></a></td><td>{{ run.route|default('-') }}</td><td>{% if run.profile=='fastest' %}<span class="history-symbol" role="img" aria-label="Fastest" title="Fastest">&#9889;</span>{% elseif run.profile=='reliability' %}<span class="history-symbol" role="img" aria-label="Reliability" title="Reliability">&#128737;</span>{% else %}<span class="history-symbol" role="img" aria-label="Balanced" title="Balanced">&#9878;</span>{% endif %}</td><td>{% if run.target_speed_mph is not null %}{{ run.target_speed_mph|number_format(1) }} mph{% else %}-{% endif %}</td><td>{% if run.departure %}<time class="eastern-time" datetime="{{ run.departure }}">{{ run.departure }}</time>{% else %}{{ run.stage }}{% endif %}</td><td>{% if run.risk is not null %}{{ (run.risk*100)|number_format(1) }}%{% else %}-{% endif %}</td><td>{% if run.expected_seconds is not null %}{% set total_minutes=(run.expected_seconds/60)|round %}{{ (total_minutes/60)|round(0,'floor') }} hr {{ '%02d'|format(total_minutes%60) }} min{% else %}-{% endif %}</td><td>{{ run.matches }}</td><td>{% if role in ['admin','superadmin'] %}<form method="post" action="/history/{{ run.id }}/delete" onsubmit="return confirm('Delete this analysis run?')"><input type="hidden" name="_token" value="{{ csrf }}"><button class="small">Delete</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="11">No matching calculations have been recorded.</td></tr>{% endfor %}</tbody></table></div>
<div class="pagination" role="navigation" aria-label="Calculated runs pages">{% if page>1 %}<a href="?{{ history_state }}&amp;sort={{ sort }}&amp;dir={{ direction }}&amp;page={{ page-1 }}" title="Previous page" aria-label="Previous page">&larr;</a>{% else %}<span class="disabled" aria-hidden="true">&larr;</span>{% endif %}<p>Page {{ page }} of {{ total_pages }} <span>{{ total_runs }} matching {{ grouped?'result group':'run' }}{{ total_runs==1?'':'s' }}</span></p>{% if page<total_pages %}<a href="?{{ history_state }}&amp;sort={{ sort }}&amp;dir={{ direction }}&amp;page={{ page+1 }}" title="Next page" aria-label="Next page">&rarr;</a>{% else %}<span class="disabled" aria-hidden="true">&rarr;</span>{% endif %}</div>
<script>const historyEastern=new Intl.DateTimeFormat('en-US',{timeZone:'America/New_York',weekday:'short',year:'numeric',month:'short',day:'numeric',hour:'numeric',minute:'2-digit',timeZoneName:'short'}),historyBrowserTime=new Intl.DateTimeFormat(undefined,{year:'numeric',month:'short',day:'numeric',hour:'numeric',minute:'2-digit',timeZoneName:'short'});document.querySelectorAll('.eastern-time').forEach(item=>item.textContent=historyEastern.format(new Date(item.dateTime))+' (New York time)');document.querySelectorAll('.browser-time').forEach(item=>item.textContent=historyBrowserTime.format(new Date(item.dateTime)));</script>{% endblock %}
