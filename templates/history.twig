{% extends 'layout.twig' %}{% block title %}Run history | CannonMiner{% endblock %}{% block content %}
<section class="page-head"><div><p class="kicker">Analysis archive</p><h1>Run history</h1></div><p>Completed runs are ranked by their recommended route's delay risk, then expected time.</p></section>
<div class="table-wrap"><table><thead><tr><th>Rank</th><th>Requested by</th><th>Route</th><th>Strategy / target</th><th>Recommended departure</th><th>Risk</th><th>Expected time</th><th>Run</th><th></th></tr></thead><tbody>
{% set rank=0 %}{% for run in runs %}{% if run.status=='complete' %}{% set rank=rank+1 %}{% endif %}
<tr><td>{% if run.status=='complete' %}{{ rank }}{% else %}-{% endif %}</td><td>{{ run.username }}</td><td><a href="/analysis/{{ run.id }}">{{ run.start_node }} to {{ run.end_node }}</a></td><td>{{ run.profile|title }}<br><span class="table-detail">{{ run.target_speed_mph|number_format(1) }} mph target avg</span></td><td>{% if run.departure %}<time class="eastern-time" datetime="{{ run.departure }}">{{ run.departure }}</time>{% else %}{{ run.stage }}{% endif %}</td><td>{% if run.risk is not null %}{{ (run.risk*100)|number_format(1) }}%{% else %}-{% endif %}</td><td>{% if run.expected_seconds is not null %}{{ (run.expected_seconds/3600)|number_format(1) }}h{% else %}-{% endif %}</td><td>{{ run.created_at|date('Y-m-d H:i T') }}</td><td>{% if role in ['admin','superadmin'] %}<form method="post" action="/history/{{ run.id }}/delete" onsubmit="return confirm('Delete this analysis run?')"><input type="hidden" name="_token" value="{{ csrf }}"><button class="small">Delete</button></form>{% endif %}</td></tr>
{% else %}<tr><td colspan="9">No analysis runs have been recorded.</td></tr>{% endfor %}</tbody></table></div>
<script>const historyEastern=new Intl.DateTimeFormat('en-US',{timeZone:'America/New_York',weekday:'short',year:'numeric',month:'short',day:'numeric',hour:'numeric',minute:'2-digit',timeZoneName:'short'});document.querySelectorAll('.eastern-time').forEach(item=>item.textContent=historyEastern.format(new Date(item.dateTime))+' (New York time)');</script>
{% endblock %}
