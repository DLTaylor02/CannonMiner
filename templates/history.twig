{% extends 'layout.twig' %}{% block title %}Calculated Runs | CannonMiner{% endblock %}{% block content %}
<section class="page-head"><div><p class="kicker">Analysis archive</p><h1>Calculated Runs</h1></div><p>Filter previous calculations and organize them by the metric that matters.</p></section>
<form method="get" class="history-filter"><input type="hidden" name="sort" value="{{ sort }}"><input type="hidden" name="dir" value="{{ direction }}"><label>Calculation type<select name="type" onchange="this.form.submit()"><option value="all" {{ filter=='all'?'selected':'' }}>All</option><option value="best" {{ filter=='best'?'selected':'' }}>Best Departure</option><option value="custom" {{ filter=='custom'?'selected':'' }}>Custom Route</option><option value="automated" {{ filter=='automated'?'selected':'' }}>Automated</option></select></label><label>User<select name="user" onchange="this.form.submit()"><option value="0">All users</option>{% for item in users %}<option value="{{ item.id }}" {{ selected_user==item.id?'selected':'' }}>{{ item.username }}</option>{% endfor %}</select></label><a href="/history">Clear filters</a></form>
<div class="table-wrap"><table><thead><tr><th>Rank</th><th>Type</th><th>Requested by</th><th>Run <a class="sort-arrow {{ sort=='run'?'active':'' }}" href="?type={{ filter }}&amp;user={{ selected_user }}&amp;sort=run&amp;dir={{ sort=='run'?(direction=='asc'?'desc':'asc'):'desc' }}" title="Sort by run time" aria-label="Sort by run time">{% if sort=='run' %}{% if direction=='asc' %}&uarr;{% else %}&darr;{% endif %}{% else %}&#8597;{% endif %}</a></th><th>Route</th><th>Strategy</th><th>Target avg speed</th><th>Recommended departure</th><th>Risk <a class="sort-arrow {{ sort=='risk'?'active':'' }}" href="?type={{ filter }}&amp;user={{ selected_user }}&amp;sort=risk&amp;dir={{ sort=='risk' and direction=='asc'?'desc':'asc' }}" title="Sort by risk" aria-label="Sort by risk">{% if sort=='risk' %}{% if direction=='asc' %}&uarr;{% else %}&darr;{% endif %}{% else %}&#8597;{% endif %}</a></th><th>Expected time <a class="sort-arrow {{ sort=='expected'?'active':'' }}" href="?type={{ filter }}&amp;user={{ selected_user }}&amp;sort=expected&amp;dir={{ sort=='expected' and direction=='asc'?'desc':'asc' }}" title="Sort by expected time" aria-label="Sort by expected time">{% if sort=='expected' %}{% if direction=='asc' %}&uarr;{% else %}&darr;{% endif %}{% else %}&#8597;{% endif %}</a></th><th></th></tr></thead><tbody>
{% set rank=0 %}{% for run in runs %}{% if run.status=='complete' %}{% set rank=rank+1 %}{% endif %}<tr><td>{% if run.status=='complete' %}{{ rank }}{% else %}-{% endif %}</td><td>{{ run.job_type=='best'?'Best Departure':run.job_type|title }}</td><td>{{ run.username }}</td><td><a href="/analysis/{{ run.id }}">{{ run.created_at|date('Y-m-d H:i T') }}</a></td><td>{{ run.route|default('-') }}</td><td>{{ run.profile|title }}</td><td>{% if run.target_speed_mph is not null %}{{ run.target_speed_mph|number_format(1) }} mph{% else %}-{% endif %}</td><td>{% if run.departure %}<time class="eastern-time" datetime="{{ run.departure }}">{{ run.departure }}</time>{% else %}{{ run.stage }}{% endif %}</td><td>{% if run.risk is not null %}{{ (run.risk*100)|number_format(1) }}%{% else %}-{% endif %}</td><td>{% if run.expected_seconds is not null %}{% set total_minutes=(run.expected_seconds/60)|round %}{{ (total_minutes/60)|round(0,'floor') }} hr {{ '%02d'|format(total_minutes%60) }} min{% else %}-{% endif %}</td><td>{% if role in ['admin','superadmin'] %}<form method="post" action="/history/{{ run.id }}/delete" onsubmit="return confirm('Delete this analysis run?')"><input type="hidden" name="_token" value="{{ csrf }}"><button class="small">Delete</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="11">No matching calculations have been recorded.</td></tr>{% endfor %}</tbody></table></div>
<script>const historyEastern=new Intl.DateTimeFormat('en-US',{timeZone:'America/New_York',weekday:'short',year:'numeric',month:'short',day:'numeric',hour:'numeric',minute:'2-digit',timeZoneName:'short'});document.querySelectorAll('.eastern-time').forEach(item=>item.textContent=historyEastern.format(new Date(item.dateTime))+' (New York time)');</script>{% endblock %}
