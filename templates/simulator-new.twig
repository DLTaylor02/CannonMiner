{% extends 'layout.twig' %}{% block title %}New Simulation | CannonMiner{% endblock %}{% block content %}
<section class="page-head"><div><p class="kicker">CannonBall Trail+</p><h1>New Simulation</h1></div><p>Choose the car and crew. Your own driver is mandatory; select up to two additional drivers.</p></section>
{% if error %}<p class="alert">{{ error }}</p>{% endif %}
<form method="post" class="simulation-setup"><input type="hidden" name="_token" value="{{ csrf }}">
<fieldset><legend>Run</legend><div class="settings-grid"><label>Departure date and time <span>New York time</span><input type="datetime-local" name="departure" value="{{ default_departure }}" required></label><label>Simulation speed<select name="mode"><option value="arcade">Arcade | 1 hour = 1 minute</option><option value="realtime">Realtime | 1 minute = 1 minute</option></select></label><label>Initial target speed <span>mph</span><input type="number" name="speed" min="20" max="250" step="1" value="110" required></label></div></fieldset>
<fieldset><legend>Car</legend><label>Car<select name="car" id="car-selector" required>{% for car in cars %}<option value="{{ car.id }}" data-top="{{ car.top_speed }}" data-tuned-top="{{ car.tuned_top_speed }}" data-max-fuel-cells="{{ car.max_fuel_cells }}">{{ car.name }}</option>{% endfor %}</select></label></fieldset>
<fieldset><legend>Car builder</legend><div class="equipment-grid">
<div class="equipment-stepper"><div><strong>Fuel cells</strong><span>+20 gal capacity each | $300 each</span></div><div><button type="button" id="fuel-cell-remove" aria-label="Remove fuel cell" title="Remove fuel cell">−</button><output id="fuel-cell-count">0</output><button type="button" id="fuel-cell-add" aria-label="Add fuel cell" title="Add fuel cell">+</button><input type="hidden" id="fuel-cell-input" name="fuel_cells" value="0"></div></div>
<label class="equipment-option"><input type="checkbox" name="cruising_tune" value="yes"><i aria-hidden="true"></i><span><strong>Cruising tune</strong><small>+5 MPG above 70 mph; unlock tuned top speed | $1,500</small></span></label>
<label class="equipment-option"><input type="checkbox" name="cruising_tires" value="yes"><i aria-hidden="true"></i><span><strong>Cruising tires</strong><small>+1 MPG; −50% flat-tire chance | $1,500</small></span></label>
<label class="equipment-option"><input type="checkbox" name="radio_scanner" value="yes"><i aria-hidden="true"></i><span><strong>Radio Scanner</strong><small>Early warning response | $250</small></span></label>
<label class="equipment-option"><input type="checkbox" name="radar_scanner" value="yes"><i aria-hidden="true"></i><span><strong>Radar Scanner</strong><small>−50% police encounter chance | $600</small></span></label>
<label class="equipment-option"><input type="checkbox" name="radar_jammer" value="yes"><i aria-hidden="true"></i><span><strong>Radar Jammer</strong><small>Active police countermeasure | $1,000</small></span></label>
</div><div class="equipment-summary"><div><p class="kicker">Modifiers</p><ul id="equipment-modifiers"><li>No equipment modifiers</li></ul></div><div><span>Total equipment cost</span><strong id="equipment-cost">$0</strong></div></div></fieldset>
<fieldset><legend>Drivers</legend><div class="driver-roster">{% for driver in roster %}<label class="driver-option {{ driver.required?'required':'' }}">{% if not driver.required %}<input type="checkbox" name="drivers[]" value="{{ driver.id }}"><i aria-hidden="true"></i>{% endif %}<span><strong>{{ driver.name }}{% if driver.required %} | You{% endif %}</strong><small>Endurance {{ driver.endurance }} | Driving {{ driver.driving }} | Co-piloting {{ driver.copilot }}</small></span></label>{% endfor %}</div><label class="initial-driver">Initial driver<select name="initial_driver" required>{% for driver in roster %}<option value="{{ driver.id }}" data-optional="{{ driver.required?'no':'yes' }}" {{ driver.required?'selected':'disabled' }}>{{ driver.name }}{% if driver.required %} (you){% endif %}</option>{% endfor %}</select></label><a class="result-tool-link" href="?regenerate=1">Generate another roster</a></fieldset>
<button class="simulator-primary">Begin simulation</button></form>
<dialog id="setup-speed-warning"><div class="decision-heading"><p class="kicker">High-speed warning</p><h2>Crash risk active</h2></div><p>Above 120 mph, a high-speed crash can immediately end the run. Above 145 mph, a second higher-speed crash check also becomes active. Choose the pace with care.</p><div class="decision-options"><button class="decision-ok" type="button">OK</button></div></dialog>
<script>const rosterChecks=[...document.querySelectorAll('.driver-option input')],initialDriver=document.querySelector('[name=initial_driver]'),speedInput=document.querySelector('[name=speed]'),speedWarning=document.getElementById('setup-speed-warning'),carSelector=document.getElementById('car-selector'),fuelCellInput=document.getElementById('fuel-cell-input'),fuelCellCount=document.getElementById('fuel-cell-count'),tuneInput=document.querySelector('[name=cruising_tune]'),tiresInput=document.querySelector('[name=cruising_tires]'),radioInput=document.querySelector('[name=radio_scanner]'),radarInput=document.querySelector('[name=radar_scanner]'),jammerInput=document.querySelector('[name=radar_jammer]');let highSpeedWarningShown=false;function syncDrivers(){rosterChecks.forEach(check=>{const option=initialDriver.querySelector(`[value="${check.value}"]`);option.disabled=!check.checked});if(initialDriver.selectedOptions[0].disabled)initialDriver.value='self'}function warnSpeed(){const car=carSelector.selectedOptions[0],top=Number(tuneInput.checked?car.dataset.tunedTop:car.dataset.top),highSpeed=Math.min(Number(speedInput.value),top)>120;if(highSpeed&&!highSpeedWarningShown&&!speedWarning.open)speedWarning.showModal();highSpeedWarningShown=highSpeed}function syncEquipment(){const max=Number(carSelector.selectedOptions[0].dataset.maxFuelCells),cells=Math.max(0,Math.min(max,Number(fuelCellInput.value)||0));fuelCellInput.value=String(cells);fuelCellCount.value=String(cells);document.getElementById('fuel-cell-remove').disabled=cells===0;document.getElementById('fuel-cell-add').disabled=cells===max;const modifiers=[];if(cells)modifiers.push(`+${cells*20} gal fuel capacity`);if(tuneInput.checked)modifiers.push('+5 MPG above 70 mph; tuned top speed unlocked');if(tiresInput.checked)modifiers.push('+1 MPG; flat-tire chance reduced 50%');if(radioInput.checked)modifiers.push('Radio Scanner police response');if(radarInput.checked)modifiers.push('Police encounter chance reduced 50%');if(jammerInput.checked)modifiers.push('Radar Jammer police response');document.getElementById('equipment-modifiers').innerHTML=(modifiers.length?modifiers:['No equipment modifiers']).map(item=>`<li>${item}</li>`).join('');const cost=cells*300+(tuneInput.checked?1500:0)+(tiresInput.checked?1500:0)+(radioInput.checked?250:0)+(radarInput.checked?600:0)+(jammerInput.checked?1000:0);document.getElementById('equipment-cost').textContent=new Intl.NumberFormat(undefined,{style:'currency',currency:'USD',maximumFractionDigits:0}).format(cost)}rosterChecks.forEach(check=>check.addEventListener('change',()=>{if(rosterChecks.filter(item=>item.checked).length>2)check.checked=false;syncDrivers()}));speedInput.addEventListener('input',warnSpeed);carSelector.addEventListener('change',()=>{warnSpeed();syncEquipment()});document.getElementById('fuel-cell-remove').addEventListener('click',()=>{fuelCellInput.value=String(Number(fuelCellInput.value)-1);syncEquipment()});document.getElementById('fuel-cell-add').addEventListener('click',()=>{fuelCellInput.value=String(Number(fuelCellInput.value)+1);syncEquipment()});tuneInput.addEventListener('change',()=>{syncEquipment();warnSpeed()});[tiresInput,radioInput,radarInput,jammerInput].forEach(control=>control.addEventListener('change',syncEquipment));speedWarning.querySelector('button').addEventListener('click',()=>speedWarning.close());syncDrivers();syncEquipment();</script>
{% endblock %}
