{% extends 'layout.twig' %}{% block title %}Change password | CannonMiner{% endblock %}{% block content %}
<section class="page-head"><div><p class="kicker">Account</p><h1>Change password</h1></div></section>
{% if error %}<p class="alert">{{ error }}</p>{% endif %}{% if message %}<p class="success">{{ message }}</p>{% endif %}{% if warning %}<p class="advisory">{{ warning }}</p>{% endif %}
<form method="post" class="panel password-form"><input type="hidden" name="_token" value="{{ csrf }}"><label>Current password<input type="password" name="current_password" required autocomplete="current-password"></label><label>New password<input type="password" name="password" maxlength="72" {% if role!='superadmin' %}minlength="{{ password_policy.minimum_length }}" data-password-meter{% endif %} required autocomplete="new-password"></label>{% if role!='superadmin' %}<div class="password-meter" data-strength="weak"><div><i></i></div><span>Weak</span></div><p class="password-requirements">Use uppercase and lowercase letters, a number, a symbol, and at least {{ password_policy.minimum_length }} characters.</p>{% endif %}<label>Confirm new password<input type="password" name="password_confirmation" maxlength="72" required autocomplete="new-password"></label><button>Change password</button></form>
{% endblock %}{% block scripts %}{% if role!='superadmin' %}<script>window.CannonMinerPasswordPolicy={{ password_policy|json_encode|raw }};</script><script src="/assets/password.js"></script>{% endif %}{% endblock %}
