{% extends 'layout.twig' %}{% block title %}Game Environment | CannonMiner{% endblock %}{% block content %}
<section class="page-head"><div><p class="kicker">CannonBall Trail+</p><h1>Game Environment</h1></div><a class="result-tool-link" href="/settings">Back to settings</a></section>
{% if message %}<p class="success">{{ message }}</p>{% endif %}
{% if error %}<p class="alert">{{ error }}</p>{% endif %}
<form method="post" class="settings-stack"><input type="hidden" name="_token" value="{{ csrf }}"><fieldset class="settings-group"><legend>Event probabilities</legend><p class="settings-note"><strong>&#x1f6a6; Traffic:</strong> traffic conditions are not random and cannot be assigned a percentage. They use recorded data for past departures and supported predicted data for future departures.</p><div class="settings-grid">
<label>&#x1f4a5; Base crash <span>any speed, percent per segment</span><input type="number" min="0" max="100" step="0.1" name="simulator_crash_base_percent" value="{{ settings.simulator_crash_base_percent }}"></label>
<label>&#x1f4a5; High-speed crash <span>over 120 mph, percent</span><input type="number" min="0" max="100" step="0.1" name="simulator_crash_120_percent" value="{{ settings.simulator_crash_120_percent }}"></label>
<label>&#x1f4a5; Higher-speed crash <span>over 145 mph, percent</span><input type="number" min="0" max="100" step="0.1" name="simulator_crash_145_percent" value="{{ settings.simulator_crash_145_percent }}"></label>
<label>&#x1f32b;&#xfe0f; &#x1f327;&#xfe0f; &#x1f9ca; &#x1f328;&#xfe0f; Weather <span>percent; type depends on region and season</span><input type="number" min="0" max="100" step="0.1" name="simulator_weather_percent" value="{{ settings.simulator_weather_percent }}"></label>
<label>&#x1f6de; Flat tire <span>percent</span><input type="number" min="0" max="100" step="0.1" name="simulator_flat_tire_percent" value="{{ settings.simulator_flat_tire_percent }}"></label>
<label>&#x1f32c;&#xfe0f; Headwinds <span>percent; region dependent</span><input type="number" min="0" max="100" step="0.1" name="simulator_headwind_percent" value="{{ settings.simulator_headwind_percent }}"></label>
<label>&#x1f4a8; Tailwinds <span>percent; region dependent</span><input type="number" min="0" max="100" step="0.1" name="simulator_tailwind_percent" value="{{ settings.simulator_tailwind_percent }}"></label>
<label>&#x1f693; Police <span>over 70 mph, percent</span><input type="number" min="0" max="100" step="0.1" name="simulator_police_percent" value="{{ settings.simulator_police_percent }}"></label>
<label>&#x1f6a7; Road event <span>percent</span><input type="number" min="0" max="100" step="0.1" name="simulator_road_event_percent" value="{{ settings.simulator_road_event_percent }}"></label>
</div><p class="settings-note">Percentages are baseline chances at each event opportunity and apply to new simulations. Mechanical-failure chance comes from the selected vehicle's Lemon rating. When several effects trigger together, the simulator deterministically selects one for that opportunity. The base crash chance is checked once per segment at any speed.</p></fieldset><fieldset class="settings-group"><legend>Load costs</legend><div class="settings-grid"><label>Each driver<input type="number" min="0" max="100000" step="1" name="simulator_load_driver" value="{{ settings.simulator_load_driver }}"></label><label>Each fuel cell<input type="number" min="0" max="100000" step="1" name="simulator_load_fuel_cell" value="{{ settings.simulator_load_fuel_cell }}"></label><label>Additional Spare<input type="number" min="0" max="100000" step="1" name="simulator_load_additional_spare" value="{{ settings.simulator_load_additional_spare }}"></label><label>Cruising tires<input type="number" min="0" max="100000" step="1" name="simulator_load_cruising_tires" value="{{ settings.simulator_load_cruising_tires }}"></label><label>Cruising tune<input type="number" min="0" max="100000" step="1" name="simulator_load_cruising_tune" value="{{ settings.simulator_load_cruising_tune }}"></label><label>&#x1f527; Tuned up<input type="number" min="0" max="100000" step="1" name="simulator_load_tuned_up" value="{{ settings.simulator_load_tuned_up }}"></label><label>Radio scanner<input type="number" min="0" max="100000" step="1" name="simulator_load_radio_scanner" value="{{ settings.simulator_load_radio_scanner }}"></label><label>Radar scanner<input type="number" min="0" max="100000" step="1" name="simulator_load_radar_scanner" value="{{ settings.simulator_load_radar_scanner }}"></label><label>Radar jammer<input type="number" min="0" max="100000" step="1" name="simulator_load_radar_jammer" value="{{ settings.simulator_load_radar_jammer }}"></label></div></fieldset><fieldset class="settings-group"><legend>Driver roster</legend><label>Candidate names <span>One name per line; at least six unique names are required.</span><textarea class="banner-textarea" name="simulator_driver_names" rows="16" required>{{ settings.simulator_driver_names }}</textarea></label></fieldset><button class="settings-save">Save game environment</button></form>

<section class="section-heading game-vehicle-heading"><div><p class="kicker">Garage</p><h2>Vehicles</h2></div></section>
<form method="post" action="/settings/game/vehicles" enctype="multipart/form-data" class="settings-stack vehicle-editor"><input type="hidden" name="_token" value="{{ csrf }}"><fieldset class="settings-group"><legend>Add vehicle</legend><div class="settings-grid vehicle-fields">
<label>Name<input name="name" maxlength="120" required></label><label>MPG below 35<input type="number" name="mpg_below_35" min="0.1" max="500" step="0.1" required></label><label>MPG 35–70<input type="number" name="mpg_35_70" min="0.1" max="500" step="0.1" required></label><label>MPG above 70<input type="number" name="mpg_above_70" min="0.1" max="500" step="0.1" required></label><label>Fuel capacity <span>gallons</span><input type="number" name="capacity" min="0.1" max="500" step="0.1" required></label><label>Top speed <span>mph</span><input type="number" name="top_speed" min="1" max="500" step="0.1" required></label><label>Tuned top speed <span>mph</span><input type="number" name="tuned_top_speed" min="1" max="500" step="0.1" required></label><label>Maximum fuel cells<input type="number" name="max_fuel_cells" min="0" max="20" step="1" required></label><label>Maximum load<input type="number" name="max_load" min="1" max="100000" step="1" required></label><label>Vehicle image <span>128×128 transparent PNG, 256 KB maximum</span><input type="file" name="image" accept="image/png"></label>
<label>Lemon <span>mechanical-failure percent</span><input type="number" name="lemon" min="0" max="100" step="0.1" value="1" required></label>
</div><button class="settings-save">Add vehicle</button></fieldset></form>

<div class="vehicle-editor-list">{% for vehicle in vehicles %}<article class="outlined-section vehicle-editor-card"><form method="post" action="/settings/game/vehicles/{{ vehicle.id }}" enctype="multipart/form-data"><input type="hidden" name="_token" value="{{ csrf }}"><div class="vehicle-editor-title">{% if vehicle.image_path %}<img src="{{ vehicle.image_path }}" width="48" height="48" alt="">{% else %}<span class="vehicle-image-placeholder" aria-hidden="true">&#x1f697;</span>{% endif %}<h3>{{ vehicle.name }}</h3></div><div class="settings-grid vehicle-fields">
<label>Name<input name="name" maxlength="120" value="{{ vehicle.name }}" required></label><label>MPG below 35<input type="number" name="mpg_below_35" min="0.1" max="500" step="0.1" value="{{ vehicle.mpg_below_35 }}" required></label><label>MPG 35–70<input type="number" name="mpg_35_70" min="0.1" max="500" step="0.1" value="{{ vehicle.mpg_35_70 }}" required></label><label>MPG above 70<input type="number" name="mpg_above_70" min="0.1" max="500" step="0.1" value="{{ vehicle.mpg_above_70 }}" required></label><label>Fuel capacity <span>gallons</span><input type="number" name="capacity" min="0.1" max="500" step="0.1" value="{{ vehicle.capacity }}" required></label><label>Top speed <span>mph</span><input type="number" name="top_speed" min="1" max="500" step="0.1" value="{{ vehicle.top_speed }}" required></label><label>Tuned top speed <span>mph</span><input type="number" name="tuned_top_speed" min="1" max="500" step="0.1" value="{{ vehicle.tuned_top_speed }}" required></label><label>Maximum fuel cells<input type="number" name="max_fuel_cells" min="0" max="20" step="1" value="{{ vehicle.max_fuel_cells }}" required></label><label>Maximum load<input type="number" name="max_load" min="1" max="100000" step="1" value="{{ vehicle.max_load }}" required></label><label>Replace image <span>128×128 transparent PNG</span><input type="file" name="image" accept="image/png"></label>
<label>Lemon <span>mechanical-failure percent</span><input type="number" name="lemon" min="0" max="100" step="0.1" value="{{ vehicle.lemon }}" required></label>
</div><button class="settings-save">Save vehicle</button></form><form method="post" action="/settings/game/vehicles/{{ vehicle.id }}/delete" onsubmit="return confirm('Remove this vehicle?')"><input type="hidden" name="_token" value="{{ csrf }}"><button class="history-delete" type="submit" aria-label="Delete {{ vehicle.name }}" title="Delete vehicle">X</button></form></article>{% endfor %}</div>
{% endblock %}
