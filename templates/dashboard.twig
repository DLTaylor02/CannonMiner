{% extends 'layout.twig' %}{% block title %}Plan the Run | CannonMiner{% endblock %}{% block content %}
<section class="page-head"><div><p class="kicker">Route intelligence</p><h1>Best Departure and Route</h1></div><p>Compare every available route and historical departure pattern.</p></section>
<form method="post" class="route-form"><input type="hidden" name="_token" value="{{ csrf }}"><input type="hidden" name="_mode" value="best"><label>Start<select name="start">{% for node in nodes %}<option {{ node==input.start?'selected':'' }}>{{ node }}</option>{% endfor %}</select></label><label>Destination<select name="end">{% for node in nodes %}<option {{ node==input.end?'selected':'' }}>{{ node }}</option>{% endfor %}</select></label><label>Target speed <span>mph</span><input type="number" min="1" max="250" step="1" name="speed" value="{{ input.speed }}"></label><label>Strategy<select name="profile"><option value="balanced">Balanced</option><option value="fastest" {{ input.profile=='fastest'?'selected':'' }}>Fastest</option><option value="reliability" {{ input.profile=='reliability'?'selected':'' }}>Reliability</option></select></label>{% if role in ['admin','superadmin'] %}<label>Max risk <span>0-1</span><input type="number" min="0" max="1" step=".01" name="risk" value="{{ input.risk }}"></label>{% endif %}<button>Analyze route</button></form>
<section class="page-head subsection"><div><p class="kicker">Fixed path</p><h2>Custom Route</h2></div><p>Choose the exact route, then calculate its best departure pattern.</p></section>
<form method="post" class="route-form custom-route-form"><input type="hidden" name="_token" value="{{ csrf }}"><input type="hidden" name="_mode" value="custom"><label>Route<select name="route_index" required>{% for route in routes %}<option value="{{ loop.index0 }}">{{ route.label }}</option>{% endfor %}</select></label><label>Target speed <span>mph</span><input type="number" min="1" max="250" name="speed" value="{{ input.speed }}"></label><label>Strategy<select name="profile"><option value="balanced">Balanced</option><option value="fastest">Fastest</option><option value="reliability">Reliability</option></select></label>{% if role in ['admin','superadmin'] %}<label>Max risk <span>0-1</span><input type="number" min="0" max="1" step=".01" name="risk" value="{{ input.risk }}"></label>{% endif %}<button>Find departure</button></form>{% if error %}<p class="alert">{{ error }}</p>{% endif %}{% endblock %}
