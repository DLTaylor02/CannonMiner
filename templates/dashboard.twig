{% extends 'layout.twig' %}{% block content %}
<section class="page-head"><div><p class="kicker">Route intelligence</p><h1>Plan the run</h1></div><p>Compare the quickest traffic pattern with its actual exposure to delay.</p></section>
<form method="post" class="route-form"><input type="hidden" name="_token" value="{{ csrf }}">
<label>Start<select name="start">{% for node in nodes %}<option {{ node==input.start?'selected':'' }}>{{ node }}</option>{% endfor %}</select></label>
<label>Destination<select name="end">{% for node in nodes %}<option {{ node==input.end?'selected':'' }}>{{ node }}</option>{% endfor %}</select></label>
<label>Target speed <span>mph</span><input type="number" min="1" max="250" step="1" name="speed" value="{{ input.speed }}"></label>
<label>Strategy<select name="profile"><option value="balanced">Balanced</option><option value="fastest" {{ input.profile=='fastest'?'selected':'' }}>Fastest</option><option value="reliability" {{ input.profile=='reliability'?'selected':'' }}>Reliability</option></select></label>
{% if role in ['admin','superadmin'] %}<label>Max risk <span>0-1</span><input type="number" min="0" max="1" step=".01" name="risk" value="{{ input.risk }}"></label>{% endif %}<button>Analyze route</button></form>
{% if error %}<p class="alert">{{ error }}</p>{% endif %}
{% endblock %}
