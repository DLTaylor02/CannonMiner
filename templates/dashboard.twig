{% extends 'layout.twig' %}{% block content %}
<section class="page-head"><div><p class="kicker">Route intelligence</p><h1>Plan the run</h1></div><p>Compare the quickest traffic pattern with its actual exposure to delay.</p></section>
<form method="post" class="route-form"><label>Start<select name="start">{% for node in nodes %}<option {{ node==input.start?'selected':'' }}>{{ node }}</option>{% endfor %}</select></label><label>Destination<select name="end">{% for node in nodes %}<option {{ node==input.end?'selected':'' }}>{{ node }}</option>{% endfor %}</select></label><label>Target speed <span>mph</span><input type="number" min="1" max="250" step="1" name="speed" value="{{ input.speed }}"></label><label>Strategy<select name="profile"><option value="balanced">Balanced</option><option value="fastest" {{ input.profile=='fastest'?'selected':'' }}>Fastest</option><option value="reliability" {{ input.profile=='reliability'?'selected':'' }}>Reliability</option></select></label><label>Max risk <span>0–1</span><input type="number" min="0" max="1" step=".01" name="risk" value="{{ input.risk }}"></label><button>Analyze route</button></form>
{% if error %}<p class="alert">{{ error }}</p>{% endif %}
{% for result in results %}<article class="result"><div class="result-copy"><p class="rank">{{ loop.first?'Recommended':'Alternative '~loop.index }}</p><h2>{{ result.route }}</h2><p class="departure">{{ result.departure|date('l, M j \a\t H:i T') }}</p><div class="metrics"><div><strong>{{ (result.expected_seconds/3600)|number_format(1) }}h</strong><span>expected time</span></div><div><strong>{{ (result.congestion_seconds/60)|number_format(0) }}m</strong><span>congestion</span></div><div><strong>{{ (result.risk*100)|number_format(1) }}%</strong><span>delay risk</span></div><div><strong>{{ result.distance_miles|number_format(0) }}</strong><span>miles</span></div><div><strong>{{ result.observations }}</strong><span>matching samples</span></div></div></div><iframe title="Map of {{ result.route }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="{{ result.map_url }}"></iframe></article>{% endfor %}
{% endblock %}
