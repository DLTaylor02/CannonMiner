{% extends 'layout.twig' %}{% block title %}Dashboard | CannonMiner{% endblock %}{% block content %}
<section class="page-head"><div><p class="kicker">Operations</p><h1>Dashboard</h1></div><p>Route rankings and host capacity from recent automated calculations.</p></section>
<div class="dashboard-grid"><section class="outlined-section dashboard-wide"><div class="section-heading"><div><p class="kicker">Calculation overview</p><h2>Run metrics</h2></div></div><div class="summary-grid"><div><strong>{{ summary.completed|default(0) }}</strong><span>Completed calculations</span></div><div><strong>{{ summary.runs_24h|default(0) }}</strong><span>Runs in 24 hours</span></div><div><strong>{{ summary.best_risk is not null?(summary.best_risk*100)|number_format(1)~'%':'-' }}</strong><span>Best recorded risk</span></div><div><strong>{% if summary.avg_seconds %}{% set minutes=(summary.avg_seconds/60)|round %}{{ (minutes/60)|round(0,'floor') }} hr {{ '%02d'|format(minutes%60) }} min{% else %}-{% endif %}</strong><span>Average expected time</span></div></div></section>
<section class="outlined-section dashboard-wide"><div class="section-heading"><div><p class="kicker">Last 24 hours</p><h2>Top automated routes</h2></div></div><div class="table-wrap"><table><thead><tr><th>Route</th><th>Average risk</th><th>Average expected time</th><th>Calculations</th></tr></thead><tbody>{% for route in automated %}<tr><td><a href="/analysis/{{ route.latest_id }}">{{ route.route }}</a></td><td>{{ (route.avg_risk*100)|number_format(1) }}%</td><td>{% set minutes=(route.avg_seconds/60)|round %}{{ (minutes/60)|round(0,'floor') }} hr {{ '%02d'|format(minutes%60) }} min</td><td>{{ route.runs }}</td></tr>{% else %}<tr><td colspan="4">Automated results will appear after the first scheduled calculation.</td></tr>{% endfor %}</tbody></table></div></section>
<section class="outlined-section"><div class="section-heading"><div><p class="kicker">Utilization timeline</p><h2>CPU usage</h2></div><div class="chart-legend"><span class="host-key">Host</span><span class="app-key">CannonMiner</span></div></div><canvas id="cpu-chart" height="280" aria-label="Host and CannonMiner CPU usage over time"></canvas></section>
<section class="outlined-section"><div class="section-heading"><div><p class="kicker">Disk capacity</p><h2>Storage usage</h2></div></div><div class="storage-layout"><div><h3>Current allocation</h3><canvas id="storage-pie" height="260" aria-label="Current disk allocation"></canvas></div><div><div class="storage-chart-heading"><h3>Capacity history</h3><div class="chart-legend"><span class="storage-app-key">CannonMiner</span><span class="storage-system-key">Other system</span></div></div><canvas id="storage-growth" height="260" aria-label="CannonMiner and other system storage usage over time"></canvas></div></div></section></div>
{% endblock %}{% block scripts %}<script>window.CannonMinerMetrics={{ metrics|json_encode|raw }};</script><script src="/assets/dashboard.js"></script>{% endblock %}
