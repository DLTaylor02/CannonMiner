{% extends 'layout.twig' %}{% block title %}Settings | CannonMiner{% endblock %}{% block content %}
<section class="page-head"><div><p class="kicker">System</p><h1>Settings</h1></div></section>
<fieldset class="settings-group account-settings"><legend>Account</legend><div class="settings-grid"><div><strong>{{ user }}</strong><span>Signed-in account</span><a class="result-tool-link" href="/password">Change password</a></div></div></fieldset>
{% if role in ['admin','superadmin'] %}
{% if message %}<p class="success">{{ message }}</p>{% endif %}<form method="post" class="settings-stack"><input type="hidden" name="_token" value="{{ csrf }}">
{% if role=='superadmin' %}<fieldset class="settings-group"><legend>Dashboard</legend><div class="settings-grid settings-grid-wide"><label>MOTD text <span>Leave empty to hide the message.</span><textarea class="banner-textarea" name="dashboard_banner" maxlength="2000">{{ settings.dashboard_banner|default('') }}</textarea></label></div></fieldset>{% endif %}
{% if role=='superadmin' %}<fieldset class="settings-group"><legend>Collection</legend><div class="settings-grid"><label>Google Maps API key {% if google_key_configured %}<span>Saved</span>{% endif %}<input type="password" name="google_maps_api_key" value="{{ google_key_configured?'************':'' }}" placeholder="Directions and Maps Static APIs" autocomplete="new-password"></label><label>Traffic timezone<input name="timezone" value="{{ settings.timezone }}"></label><label>Collection interval <span>minutes</span><input type="number" min="5" max="10080" name="collection_interval_minutes" value="{{ settings.collection_interval_minutes }}"></label><label class="history-grouping settings-check"><input type="checkbox" name="google_data_storage_authorized" value="yes" {{ settings.google_data_storage_authorized=='yes'?'checked':'' }}><i aria-hidden="true"></i><span>I confirm our Google agreement permits persistent storage and analysis of this traffic data.</span></label></div></fieldset>{% endif %}
<fieldset class="settings-group"><legend>Route planning</legend><div class="settings-grid">{% if role=='superadmin' %}<label>Default target speed<input type="number" name="default_speed_mph" value="{{ settings.default_speed_mph }}"></label><label>Candidate route limit<input type="number" min="1" max="100" name="candidate_routes" value="{{ settings.candidate_routes }}"></label><label>Departure search interval <span>minutes</span><input type="number" min="5" max="60" name="departure_interval_minutes" value="{{ settings.departure_interval_minutes }}"></label><label>Cruising calculator fuel rate <span>gallons per minute</span><input type="number" min="0.1" max="100" step="0.1" name="cruising_fuel_rate_gpm" value="{{ settings.cruising_fuel_rate_gpm }}"></label>{% endif %}<label>Default maximum risk <span>percent</span><input type="number" min="0" max="100" step="1" name="default_max_delay_risk" value="{{ settings.default_max_delay_risk*100 }}"></label></div></fieldset>
{% if role=='superadmin' %}<fieldset class="settings-group"><legend>CannonBall Trail+</legend><div class="settings-grid settings-grid-wide game-settings-link"><div><strong>Game environment</strong><span>Manage events, load costs, driver names, vehicles, specifications, and vehicle artwork.</span><a class="simulator-primary" href="/settings/game">Edit game environment</a></div></div></fieldset>{% endif %}
{% if role=='superadmin' %}<fieldset class="settings-group"><legend>Security</legend><div class="settings-grid"><label>Failed sign-ins before lockout<input type="number" min="1" max="100" name="login_rate_limit" value="{{ settings.login_rate_limit }}"></label><label>Temporary lockout <span>minutes</span><input type="number" min="1" max="1440" name="login_lockout_minutes" value="{{ settings.login_lockout_minutes }}"></label><label>Minimum password length<input type="number" min="8" max="64" name="password_min_length" value="{{ settings.password_min_length }}"></label><label>Minimum password strength<select name="password_min_strength"><option value="strong" {{ settings.password_min_strength=='strong'?'selected':'' }}>Strong</option><option value="very_strong" {{ settings.password_min_strength=='very_strong'?'selected':'' }}>Very strong</option></select></label></div></fieldset>
<fieldset class="settings-group"><legend>Automation</legend><div class="settings-grid">
<label>Dashboard telemetry interval <span>minutes</span><input type="number" min="1" max="1440" name="telemetry_interval_minutes" value="{{ settings.telemetry_interval_minutes }}"></label>
<label class="history-grouping settings-check"><input type="checkbox" name="automation_enabled" value="yes" {{ settings.automation_enabled=='yes'?'checked':'' }}><i aria-hidden="true"></i><span>Run automated route calculations</span></label>
<label>Automation interval <span>minutes after the previous batch</span><input type="number" min="5" max="10080" name="automation_interval_minutes" value="{{ settings.automation_interval_minutes }}"></label>
<label>Automation target speed <span>mph</span><input type="number" min="1" max="250" name="automation_speed_mph" value="{{ settings.automation_speed_mph }}"></label>
<label>Automation strategy<select name="automation_profile"><option value="balanced" {{ settings.automation_profile=='balanced'?'selected':'' }}>Balanced</option><option value="fastest" {{ settings.automation_profile=='fastest'?'selected':'' }}>Fastest</option><option value="reliability" {{ settings.automation_profile=='reliability'?'selected':'' }}>Reliability</option></select></label>
<label>Automation maximum risk <span>percent</span><input type="number" min="0" max="100" step="1" name="automation_max_risk" value="{{ settings.automation_max_risk*100 }}"></label>
</div></fieldset>{% endif %}<button class="settings-save">Save settings</button></form>
<h2 class="section-title">Add or update segment</h2><form method="post" action="/segments" class="settings"><input type="hidden" name="_token" value="{{ csrf }}"><label>Name <span>start_to_end</span><input name="name" pattern="[a-z0-9]+_to_[a-z0-9]+" required></label><label>Origin<input name="origin" required></label><label>Destination<input name="destination" required></label><label>Origin timezone <span>IANA name</span><input name="timezone" value="America/New_York" required></label><button>Save segment</button></form>
<h2 class="section-title">Route segments</h2><div class="table-wrap"><table><thead><tr><th>Name</th><th>Origin</th><th>Destination</th><th>Origin timezone</th><th>Status</th><th></th></tr></thead><tbody>{% for row in segments %}<tr><td><strong>{{ row.name }}</strong></td><td>{{ row.origin }}</td><td>{{ row.destination }}</td><td>{{ row.timezone }}</td><td>{{ row.enabled?'Enabled':'Disabled' }}</td><td><form method="post" action="/segments/{{ row.id }}/toggle"><input type="hidden" name="_token" value="{{ csrf }}"><button class="small">{{ row.enabled?'Disable':'Enable' }}</button></form></td></tr>{% endfor %}</tbody></table></div>
<fieldset id="user-administration" class="settings-group"><legend>User administration</legend><form method="post" action="/users" class="settings user-create-form"><input type="hidden" name="_token" value="{{ csrf }}"><label>Username<input name="username" required></label><label>Password<input type="password" name="password" minlength="{{ password_policy.minimum_length }}" maxlength="72" required autocomplete="new-password" data-password-meter></label><div class="password-meter" data-strength="weak"><div><i></i></div><span>Weak</span></div><label>Role<select name="role"><option value="user">User</option><option value="gamer">Gamer</option><option value="admin">Web admin</option></select></label><button>Create user</button></form><div class="table-wrap"><table><thead><tr><th>Username</th><th>Access</th><th>Password status</th><th>Theme</th><th>Created</th><th></th></tr></thead><tbody>{% for item in users %}<tr><td><strong>{{ item.username }}</strong></td><td>{% if item.role=='superadmin' %}{% if item.id==user_id %}<form method="post" action="/users/{{ item.id }}" class="inline-user"><input type="hidden" name="_token" value="{{ csrf }}"><strong>Superadmin</strong><input type="password" name="password" maxlength="72" placeholder="New password" autocomplete="new-password"><button class="small">Update password</button></form>{% else %}Superadmin{% endif %}{% else %}<form method="post" action="/users/{{ item.id }}" class="inline-user"><input type="hidden" name="_token" value="{{ csrf }}"><select name="role"><option value="user" {{ item.role=='user'?'selected':'' }}>User</option><option value="gamer" {{ item.role=='gamer'?'selected':'' }}>Gamer</option><option value="admin" {{ item.role=='admin'?'selected':'' }}>Web admin</option></select><input type="password" name="password" minlength="{{ password_policy.minimum_length }}" maxlength="72" placeholder="New password" autocomplete="new-password" data-password-meter><button class="small">Update</button></form>{% endif %}</td><td>{% if item.role=='superadmin' %}Exempt{% elseif item.must_change_password %}<strong class="danger">Change required</strong>{% else %}<form method="post" action="/users/{{ item.id }}/must-change"><input type="hidden" name="_token" value="{{ csrf }}"><button class="small">Require change</button></form>{% endif %}</td><td>{{ item.theme }}</td><td>{{ item.created_at|date('Y-m-d') }}</td><td>{% if item.id != user_id and item.role != 'superadmin' %}<form method="post" action="/users/{{ item.id }}/delete"><input type="hidden" name="_token" value="{{ csrf }}"><button class="small">Delete</button></form>{% endif %}</td></tr>{% endfor %}</tbody></table></div></fieldset>
{% endif %}{% endblock %}
{% block scripts %}{% if role in ['admin','superadmin'] %}<script>window.CannonMinerPasswordPolicy={{ password_policy|json_encode|raw }};</script><script src="/assets/password.js"></script>{% endif %}{% endblock %}
