{% extends 'layout.twig' %}{% block title %}Settings | CannonMiner{% endblock %}{% block content %}
<section class="page-head"><div><p class="kicker">System</p><h1>Settings</h1></div></section>
{% if last_run %}<div class="collection-status"><strong>Last collection: {{ last_run.status|title }}</strong><span><time id="last-collection" datetime="{{ last_run.event_at_iso }}">{{ last_run.event_at_iso }}</time> <span id="collection-timezone">(browser local time)</span>{% if last_run.segments_collected %}, {{ last_run.segments_collected }} segments{% endif %}</span>{% if last_run.message %}<span>{{ last_run.message }}</span>{% endif %}</div>{% else %}<div class="collection-status"><strong>No collection has run yet.</strong></div>{% endif %}
{% if message %}<p class="success">{{ message }}</p>{% endif %}<form method="post" class="settings-stack"><input type="hidden" name="_token" value="{{ csrf }}">
{% if role=='superadmin' %}<fieldset class="settings-group"><legend>Collection</legend><div class="settings-grid"><label>Google Maps API key {% if google_key_configured %}<span>Saved</span>{% endif %}<input type="password" name="google_maps_api_key" value="{{ google_key_configured?'************':'' }}" placeholder="Directions and Maps Static APIs" autocomplete="new-password"></label><label>Traffic timezone<input name="timezone" value="{{ settings.timezone }}"></label><label>Collection interval <span>minutes</span><input type="number" min="5" max="10080" name="collection_interval_minutes" value="{{ settings.collection_interval_minutes }}"></label><label class="check"><input type="checkbox" name="google_data_storage_authorized" value="yes" {{ settings.google_data_storage_authorized=='yes'?'checked':'' }}><span>I confirm our Google agreement permits persistent storage and analysis of this traffic data.</span></label></div></fieldset>{% endif %}
<fieldset class="settings-group"><legend>Route planning</legend><div class="settings-grid">{% if role=='superadmin' %}<label>Default target speed<input type="number" name="default_speed_mph" value="{{ settings.default_speed_mph }}"></label><label>Candidate route limit<input type="number" min="1" max="100" name="candidate_routes" value="{{ settings.candidate_routes }}"></label><label>Departure search interval <span>minutes</span><input type="number" min="5" max="60" name="departure_interval_minutes" value="{{ settings.departure_interval_minutes }}"></label>{% endif %}<label>Default maximum risk<input type="number" min="0" max="1" step=".01" name="default_max_delay_risk" value="{{ settings.default_max_delay_risk }}"></label></div></fieldset>
{% if role=='superadmin' %}<fieldset class="settings-group"><legend>Security</legend><div class="settings-grid"><label>Failed sign-ins before lockout<input type="number" min="1" max="100" name="login_rate_limit" value="{{ settings.login_rate_limit }}"></label><label>Temporary lockout <span>minutes</span><input type="number" min="1" max="1440" name="login_lockout_minutes" value="{{ settings.login_lockout_minutes }}"></label><label>Minimum password length<input type="number" min="8" max="64" name="password_min_length" value="{{ settings.password_min_length }}"></label><label>Minimum password strength<select name="password_min_strength"><option value="strong" {{ settings.password_min_strength=='strong'?'selected':'' }}>Strong</option><option value="very_strong" {{ settings.password_min_strength=='very_strong'?'selected':'' }}>Very strong</option></select></label></div></fieldset>
<fieldset class="settings-group"><legend>Automation</legend><div class="settings-grid">
<label>Dashboard telemetry interval <span>minutes</span><input type="number" min="1" max="1440" name="telemetry_interval_minutes" value="{{ settings.telemetry_interval_minutes }}"></label>
<label class="check"><input type="checkbox" name="automation_enabled" value="yes" {{ settings.automation_enabled=='yes'?'checked':'' }}><span>Run automated route calculations</span></label>
<label>Run every <span>hours</span><input type="number" min="1" max="168" name="automation_interval_hours" value="{{ settings.automation_interval_hours }}"></label>
<label>Start at minute <span>0-59 within the scheduled hour</span><input type="number" min="0" max="59" name="automation_start_minute" value="{{ settings.automation_start_minute }}"></label>
<label>Automation target speed <span>mph</span><input type="number" min="1" max="250" name="automation_speed_mph" value="{{ settings.automation_speed_mph }}"></label>
<label>Automation strategy<select name="automation_profile"><option value="balanced" {{ settings.automation_profile=='balanced'?'selected':'' }}>Balanced</option><option value="fastest" {{ settings.automation_profile=='fastest'?'selected':'' }}>Fastest</option><option value="reliability" {{ settings.automation_profile=='reliability'?'selected':'' }}>Reliability</option></select></label>
<label>Automation maximum risk<input type="number" min="0" max="1" step=".01" name="automation_max_risk" value="{{ settings.automation_max_risk }}"></label>
</div></fieldset>{% endif %}<button class="settings-save">Save settings</button></form>
<script>const collectionTime=document.getElementById('last-collection'),collectionZone=document.getElementById('collection-timezone');if(collectionTime){const instant=new Date(collectionTime.dateTime),zone=Intl.DateTimeFormat().resolvedOptions().timeZone||'local timezone';collectionTime.textContent=new Intl.DateTimeFormat(undefined,{year:'numeric',month:'short',day:'numeric',hour:'numeric',minute:'2-digit',second:'2-digit',timeZoneName:'short'}).format(instant);collectionZone.textContent=`(browser local time: ${zone})`;}</script>
<h2 class="section-title">Add or update segment</h2><form method="post" action="/segments" class="settings"><input type="hidden" name="_token" value="{{ csrf }}"><label>Name <span>start_to_end</span><input name="name" pattern="[a-z0-9]+_to_[a-z0-9]+" required></label><label>Origin<input name="origin" required></label><label>Destination<input name="destination" required></label><label>Origin timezone <span>IANA name</span><input name="timezone" value="America/New_York" required></label><button>Save segment</button></form>
<h2 class="section-title">Route segments</h2><div class="table-wrap"><table><thead><tr><th>Name</th><th>Origin</th><th>Destination</th><th>Origin timezone</th><th>Status</th><th></th></tr></thead><tbody>{% for row in segments %}<tr><td><strong>{{ row.name }}</strong></td><td>{{ row.origin }}</td><td>{{ row.destination }}</td><td>{{ row.timezone }}</td><td>{{ row.enabled?'Enabled':'Disabled' }}</td><td><form method="post" action="/segments/{{ row.id }}/toggle"><input type="hidden" name="_token" value="{{ csrf }}"><button class="small">{{ row.enabled?'Disable':'Enable' }}</button></form></td></tr>{% endfor %}</tbody></table></div>{% endblock %}
