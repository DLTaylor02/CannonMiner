{% extends 'layout.twig' %}{% block title %}Avoid trends | CannonMiner{% endblock %}{% block content %}
<section class="page-head"><div><p class="kicker">Historical risk</p><h1>Windows to avoid</h1></div><p>The highest recurring congestion penalties, ranked by average delay.</p></section>
<div class="table-wrap"><table><thead><tr><th>Segment</th><th>Day</th><th>Local hour</th><th>Origin timezone</th><th>Average delay</th><th>90th percentile</th><th>Samples</th></tr></thead><tbody>{% set days=['','Mon','Tue','Wed','Thu','Fri','Sat','Sun'] %}{% for row in trends %}<tr><td><strong>{{ row.name|replace({'_to_':' to '}) }}</strong></td><td>{{ days[row.weekday] }}</td><td>{{ '%02d:00'|format(row.hour) }}</td><td>{{ row.timezone }}</td><td class="danger">+{{ (row.avg_delay/60)|number_format(0) }} min</td><td>+{{ (row.p90_delay/60)|number_format(0) }} min</td><td>{{ row.observations }}</td></tr>{% else %}<tr><td colspan="7">Collect at least two samples per time window to reveal trends.</td></tr>{% endfor %}</tbody></table></div>{% endblock %}
