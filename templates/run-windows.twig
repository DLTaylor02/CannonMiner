{% extends 'layout.twig' %}{% block title %}Run Windows | CannonMiner{% endblock %}{% block content %}
<section class="page-head"><div><p class="kicker">Projection archive</p><h1>Run Windows</h1></div><p>Open previous future projections and their printable route recommendations.</p></section>
<div class="table-wrap"><table><thead><tr><th>Projected</th><th>Requested by</th><th>Planning range</th><th>Strategy</th><th>Target avg speed</th><th>Recommended route</th><th>Recommended departure</th><th>Risk</th><th>Confidence</th></tr></thead><tbody>
{% for window in windows %}<tr><td><a href="/plan/{{ window.id }}"><time class="browser-time" datetime="{{ window.created_at|date('c') }}">{{ window.created_at|date('Y-m-d H:i T') }}</time></a></td><td>{{ window.username }}</td><td>{{ window.start_date }} to {{ window.end_date }}</td><td>{{ window.profile|title }}</td><td>{{ window.target_speed_mph|number_format(1) }} mph</td><td>{{ window.route|default('-') }}</td><td>{% if window.departure %}<time class="eastern-time" datetime="{{ window.departure|date('c') }}">{{ window.departure }}</time>{% else %}{{ window.stage }}{% endif %}</td><td>{% if window.risk is not null %}{{ (window.risk*100)|number_format(1) }}%{% else %}-{% endif %}</td><td>{% if window.confidence is not null %}{{ (window.confidence*100)|number_format(0) }}%{% else %}-{% endif %}</td></tr>{% else %}<tr><td colspan="9">No future projections have been recorded.</td></tr>{% endfor %}</tbody></table></div>
<div class="pagination" role="navigation" aria-label="Run windows pages">{% if page>1 %}<a href="?page={{ page-1 }}" title="Previous page" aria-label="Previous page">&larr;</a>{% else %}<span class="disabled" aria-hidden="true">&larr;</span>{% endif %}<p>Page {{ page }} of {{ total_pages }} <span>{{ total }} projection{{ total==1?'':'s' }}</span></p>{% if page<total_pages %}<a href="?page={{ page+1 }}" title="Next page" aria-label="Next page">&rarr;</a>{% else %}<span class="disabled" aria-hidden="true">&rarr;</span>{% endif %}</div>
<script>const runWindowLocal=new Intl.DateTimeFormat(undefined,{year:'numeric',month:'short',day:'numeric',hour:'numeric',minute:'2-digit',timeZoneName:'short'}),runWindowEastern=new Intl.DateTimeFormat('en-US',{timeZone:'America/New_York',weekday:'short',year:'numeric',month:'short',day:'numeric',hour:'numeric',minute:'2-digit',timeZoneName:'short'});document.querySelectorAll('.browser-time').forEach(item=>item.textContent=runWindowLocal.format(new Date(item.dateTime)));document.querySelectorAll('.eastern-time').forEach(item=>item.textContent=runWindowEastern.format(new Date(item.dateTime))+' (New York time)');</script>
{% endblock %}
