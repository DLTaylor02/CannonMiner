{% extends 'layout.twig' %}{% block title %}Users | CannonMiner{% endblock %}{% block content %}
<section class="page-head"><div><p class="kicker">Access</p><h1>Users</h1></div></section>{% if message %}<p class="success">{{ message }}</p>{% endif %}{% if error %}<p class="alert">{{ error }}</p>{% endif %}{% if warning %}<p class="advisory">{{ warning }}</p>{% endif %}
<form method="post" class="settings"><input type="hidden" name="_token" value="{{ csrf }}"><label>Username<input name="username" required></label><label>Password<input type="password" name="password" minlength="{{ password_policy.minimum_length }}" maxlength="72" required autocomplete="new-password" data-password-meter></label><div class="password-meter" data-strength="weak"><div><i></i></div><span>Weak</span></div><label>Role<select name="role"><option value="user">User</option><option value="admin">Web admin</option></select></label><button>Create user</button></form>
<div class="table-wrap"><table><thead><tr><th>Username</th><th>Access</th><th>Password status</th><th>Theme</th><th>Created</th><th></th></tr></thead><tbody>{% for item in users %}<tr><td><strong>{{ item.username }}</strong></td><td>{% if item.role=='superadmin' %}{% if item.id==user_id %}<form method="post" action="/users/{{ item.id }}" class="inline-user"><input type="hidden" name="_token" value="{{ csrf }}"><strong>Superadmin</strong><input type="password" name="password" maxlength="72" placeholder="New password" autocomplete="new-password"><button class="small">Update password</button></form>{% else %}Superadmin{% endif %}{% else %}<form method="post" action="/users/{{ item.id }}" class="inline-user"><input type="hidden" name="_token" value="{{ csrf }}"><select name="role"><option value="user" {{ item.role=='user'?'selected':'' }}>User</option><option value="admin" {{ item.role=='admin'?'selected':'' }}>Web admin</option></select><input type="password" name="password" minlength="{{ password_policy.minimum_length }}" maxlength="72" placeholder="New password" autocomplete="new-password" data-password-meter><button class="small">Update</button></form>{% endif %}</td><td>{% if item.role=='superadmin' %}Exempt{% elseif item.must_change_password %}<strong class="danger">Change required</strong>{% else %}<form method="post" action="/users/{{ item.id }}/must-change"><input type="hidden" name="_token" value="{{ csrf }}"><button class="small">Require change</button></form>{% endif %}</td><td>{{ item.theme }}</td><td>{{ item.created_at|date('Y-m-d') }}</td><td>{% if item.id != user_id and item.role != 'superadmin' %}<form method="post" action="/users/{{ item.id }}/delete"><input type="hidden" name="_token" value="{{ csrf }}"><button class="small">Delete</button></form>{% endif %}</td></tr>{% endfor %}</tbody></table></div>{% endblock %}
{% block scripts %}<script>window.CannonMinerPasswordPolicy={{ password_policy|json_encode|raw }};</script><script src="/assets/password.js"></script>{% endblock %}
