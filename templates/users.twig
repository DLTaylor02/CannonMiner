{% extends 'layout.twig' %}{% block title %}Users | CannonMiner{% endblock %}{% block content %}
<section class="page-head"><div><p class="kicker">Access</p><h1>Users</h1></div></section>{% if message %}<p class="success">{{ message }}</p>{% endif %}{% if error %}<p class="alert">{{ error }}</p>{% endif %}
<form method="post" class="settings"><input type="hidden" name="_token" value="{{ csrf }}"><label>Username<input name="username" required></label><label>Password<input type="password" name="password" minlength="12" required autocomplete="new-password"></label><label>Role<select name="role"><option value="user">User</option><option value="admin">Web admin</option>{% if role=='superadmin' %}<option value="superadmin">Superadmin</option>{% endif %}</select></label><button>Create user</button></form>
<div class="table-wrap"><table><thead><tr><th>Username</th><th>Access</th><th>Theme</th><th>Created</th><th></th></tr></thead><tbody>{% for item in users %}<tr><td><strong>{{ item.username }}</strong></td><td>{% if item.role=='superadmin' and role!='superadmin' %}Superadmin{% else %}<form method="post" action="/users/{{ item.id }}" class="inline-user"><input type="hidden" name="_token" value="{{ csrf }}"><select name="role"><option value="user" {{ item.role=='user'?'selected':'' }}>User</option><option value="admin" {{ item.role=='admin'?'selected':'' }}>Web admin</option>{% if role=='superadmin' %}<option value="superadmin" {{ item.role=='superadmin'?'selected':'' }}>Superadmin</option>{% endif %}</select><input type="password" name="password" minlength="12" placeholder="New password" autocomplete="new-password"><button class="small">Update</button></form>{% endif %}</td><td>{{ item.theme }}</td><td>{{ item.created_at|date('Y-m-d') }}</td><td>{% if item.id != user_id and (item.role != 'superadmin' or role == 'superadmin') %}<form method="post" action="/users/{{ item.id }}/delete"><input type="hidden" name="_token" value="{{ csrf }}"><button class="small">Delete</button></form>{% endif %}</td></tr>{% endfor %}</tbody></table></div>{% endblock %}
