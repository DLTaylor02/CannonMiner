{% extends 'layout.twig' %}{% block title %}Calendar | CannonMiner{% endblock %}{% block content %}
<section class="page-head"><div><p class="kicker">Departure patterns</p><h1>Calendar</h1></div><p>Days selected most often as the recommended departure across completed calculations.</p></section>
<form method="get" class="calendar-filter"><label>Target average speed<select name="speed" onchange="this.form.submit()">{% for speed in speeds %}<option value="{{ speed|number_format(1,'.','') }}" {{ speed==selected_speed?'selected':'' }}>{{ speed|number_format(1) }} mph</option>{% endfor %}</select></label><label>Year<select name="year" onchange="this.form.submit()">{% for year in years %}<option value="{{ year }}" {{ year==selected_year?'selected':'' }}>{{ year }}</option>{% endfor %}</select></label></form>
<section class="calendar-summary"><div><strong>{{ selected_year }}</strong><span>Calendar year</span></div><div><strong>{{ selected_speed|number_format(1) }} mph</strong><span>Target average speed</span></div><div><strong>{{ maximum }}</strong><span>Busiest-day calculations</span></div><div class="calendar-legend"><span>Fewer</span><i></i><span>More</span></div></section>
<div class="year-calendar">{% for month in months %}<section class="calendar-month"><h2>{{ month.name }}</h2><div class="calendar-weekdays" aria-hidden="true"><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span></div><div class="calendar-days">{% if month.offset %}{% for blank in 1..month.offset %}<span class="calendar-blank" aria-hidden="true"></span>{% endfor %}{% endif %}{% for day in month.days %}<div class="calendar-day {{ day.count?'has-runs':'empty' }} {{ day.dark?'dark-cell':'' }}"{% if day.color %} style="background:{{ day.color }}"{% endif %} role="img"{% if day.count %} tabindex="0" aria-describedby="departures-{{ day.date }}"{% endif %} aria-label="{{ day.date }}, {{ day.count }} calculation{{ day.count==1?'':'s' }}"><span>{{ day.number }}</span><strong>{{ day.count ? day.count : '' }}</strong>{% if day.count %}<span class="calendar-popover" id="departures-{{ day.date }}" role="tooltip"><strong>{{ day.date }}</strong><small>New York departure times</small>{% for departure in day.departures %}<span><time datetime="{{ departure.time }}">{{ departure.label }}</time><b>{{ departure.count }} calculation{{ departure.count==1?'':'s' }}</b></span>{% endfor %}</span>{% endif %}</div>{% endfor %}</div></section>{% endfor %}</div>
{% endblock %}
