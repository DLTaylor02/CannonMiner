{% extends 'layout.twig' %}{% block title %}Calendar | CannonMiner{% endblock %}{% block content %}
<section class="page-head"><div><p class="kicker">Departure patterns</p><h1>Calendar</h1></div><p>Supported recommendations and directly observed traffic patterns across the year.</p></section>
<form method="get" class="calendar-filter"><label>Target average speed<select name="speed" onchange="this.form.submit()">{% for speed in speeds %}<option value="{{ speed|number_format(1,'.','') }}" {{ speed==selected_speed?'selected':'' }}>{{ speed|number_format(1) }} mph</option>{% endfor %}</select></label><label>Year<select name="year" onchange="this.form.submit()">{% for year in years %}<option value="{{ year }}" {{ year==selected_year?'selected':'' }}>{{ year }}</option>{% endfor %}</select></label></form>
<section class="calendar-summary"><div><strong>{{ selected_year }}</strong><span>Calendar year</span></div><div><strong>{{ selected_speed|number_format(1) }} mph</strong><span>Target average speed</span></div><div><strong>{{ maximum|number_format(2) }}</strong><span>Highest daily points</span></div><div class="calendar-legends"><div class="calendar-legend recommendation"><span>Fewer points</span><i></i><span>More</span></div><div class="calendar-legend traffic"><span>Lower delay</span><i></i><span>Higher</span></div></div></section>
<div class="year-calendar">{% for month in months %}<section class="calendar-month"><h2>{{ month.name }}</h2><div class="calendar-weekdays" aria-hidden="true"><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span></div><div class="calendar-days">{% if month.offset %}{% for blank in 1..month.offset %}<span class="calendar-blank" aria-hidden="true"></span>{% endfor %}{% endif %}{% for day in month.days %}{% set interactive=day.count or day.trends or day.holidays %}<div class="calendar-day {{ day.count?'has-runs':'empty' }} {{ day.trends?'has-trends':'' }} {{ day.holidays?'has-holiday':'' }} {{ day.dark?'dark-cell':'' }}"{% if day.color or day.trend_color %} style="{% if day.color %}background:{{ day.color }};{% endif %}{% if day.trend_color %}--traffic-color:{{ day.trend_color }};{% endif %}"{% endif %} role="group"{% if interactive %} tabindex="0" aria-describedby="day-details-{{ day.date }}"{% endif %} aria-label="{{ day.date }}{% if day.count %}, {{ day.count|number_format(2) }} points from {{ day.recommendations }} recommendations{% endif %}{% if day.trends %}, predicted traffic conditions to avoid{% endif %}{% if day.holidays %}, {{ day.holidays|join(', ') }}{% endif %}"><span>{{ day.number }}</span><strong>{{ day.count ? day.count|number_format(1) : '' }}</strong>{% if day.holidays %}<i class="holiday-star" aria-hidden="true">&#11088;</i>{% endif %}{% if interactive %}<span class="calendar-popover" id="day-details-{{ day.date }}" role="tooltip"><strong>{{ day.date }}</strong>{% for holiday in day.holidays %}<span class="holiday-name"><i aria-hidden="true">&#11088;</i><b>{{ holiday }}</b></span>{% endfor %}{% if day.count %}<small>{{ day.count|number_format(2) }} points from {{ day.recommendations }} recommendation{{ day.recommendations==1?'':'s' }}. New York departure times:</small>{% for departure in day.departures %}<span><a href="/analysis/{{ departure.run_id }}"><time datetime="{{ departure.time }}">{{ departure.label }}</time></a><b>{{ departure.points|number_format(2) }} points ({{ departure.count }})</b></span>{% endfor %}{% endif %}{% if day.trends %}<small class="traffic-heading">Predicted traffic conditions to avoid</small>{% for trend in day.trends %}<span class="traffic-detail"><span><b>{{ trend.name|replace({'_to_':' to '}) }}</b><time>{{ trend.time }}</time></span><span>Average +{{ (trend.avg_delay/60)|number_format(0) }} min<br>90th percentile +{{ (trend.p90_delay/60)|number_format(0) }} min<br>{{ trend.observations }} samples</span></span>{% endfor %}{% endif %}{% if not day.count and not day.trends %}<small>No matching calculated departures</small>{% endif %}</span>{% endif %}</div>{% endfor %}</div></section>{% endfor %}</div>
{% endblock %}
