{% extends 'layout.twig' %}{% block title %}Calendar | CannonMiner{% endblock %}{% block content %}
<section class="page-head"><div><p class="kicker">Departure patterns</p><h1>Calendar</h1></div><p>Confidence that each day is the best departure across current calculation configurations.</p></section>
<form method="get" class="calendar-filter"><label>Target average speed<select name="speed" onchange="this.form.submit()">{% for speed in speeds %}<option value="{{ speed|number_format(1,'.','') }}" {{ speed==selected_speed?'selected':'' }}>{{ speed|number_format(1) }} mph</option>{% endfor %}</select></label><label>Year<select name="year" onchange="this.form.submit()">{% for year in years %}<option value="{{ year }}" {{ year==selected_year?'selected':'' }}>{{ year }}</option>{% endfor %}</select></label></form>
<section class="calendar-summary"><div><strong>{{ selected_year }}</strong><span>Calendar year</span></div><div><strong>{{ selected_speed|number_format(1) }} mph</strong><span>Target average speed</span></div><div><strong>{{ maximum|number_format(1) }}</strong><span>Highest confidence points</span></div><div class="calendar-legend"><span>Lower</span><i></i><span>Higher</span></div></section>
<div class="year-calendar">{% for month in months %}<section class="calendar-month"><h2>{{ month.name }}</h2><div class="calendar-weekdays" aria-hidden="true"><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span></div><div class="calendar-days">{% if month.offset %}{% for blank in 1..month.offset %}<span class="calendar-blank" aria-hidden="true"></span>{% endfor %}{% endif %}{% for day in month.days %}{% set interactive=day.count or day.holidays %}<div class="calendar-day {{ day.count?'has-runs':'empty' }} {{ day.holidays?'has-holiday':'' }} {{ day.dark?'dark-cell':'' }}"{% if day.color %} style="background:{{ day.color }}"{% endif %} role="img"{% if interactive %} tabindex="0" aria-describedby="day-details-{{ day.date }}"{% endif %} aria-label="{{ day.date }}, {{ day.count|number_format(1) }} confidence points{% if day.holidays %}, {{ day.holidays|join(', ') }}{% endif %}"><span>{{ day.number }}</span><strong>{{ day.count ? day.count|number_format(1) : '' }}</strong>{% if day.holidays %}<i class="holiday-star" aria-hidden="true">&#11088;</i>{% endif %}{% if interactive %}<span class="calendar-popover" id="day-details-{{ day.date }}" role="tooltip"><strong>{{ day.date }}</strong>{% for holiday in day.holidays %}<span class="holiday-name"><i aria-hidden="true">&#11088;</i><b>{{ holiday }}</b></span>{% endfor %}{% if day.count %}<small>New York departure confidence</small>{% for departure in day.departures %}<span><time datetime="{{ departure.time }}">{{ departure.label }}</time><b>{{ departure.count|number_format(1) }} points</b></span>{% endfor %}{% else %}<small>No supported departure candidates</small>{% endif %}</span>{% endif %}</div>{% endfor %}</div></section>{% endfor %}</div>
{% endblock %}
