<!doctype html><html lang="en" data-theme="{{ theme|default('adaptive') }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{% block title %}CannonMiner{% endblock %}</title><link rel="stylesheet" href="/assets/app.css"><link rel="stylesheet" href="/assets/theme.css"><link rel="stylesheet" href="/assets/progress.css"><link rel="stylesheet" href="/assets/admin.css"></head><body>
{% if user %}<header><a class="brand" href="/">CannonMiner</a><nav class="desktop-nav"><a href="/plan">Plan the Run</a><a href="/history">Calculated Runs</a><a href="/trends">Avoid trends</a><a href="/password">Change password</a>{% if role in ['admin','superadmin'] %}<a href="/settings">Settings</a><a href="/users">Users</a>{% endif %}</nav><form class="theme-form" method="post" action="/theme"><input type="hidden" name="_token" value="{{ csrf }}"><select name="theme" aria-label="Theme" onchange="this.form.submit()"><option value="adaptive" {{ theme=='adaptive'?'selected':'' }}>Adaptive</option><option value="light" {{ theme=='light'?'selected':'' }}>Light</option><option value="dark" {{ theme=='dark'?'selected':'' }}>Dark</option></select></form><form class="desktop-logout" method="post" action="/logout"><input type="hidden" name="_token" value="{{ csrf }}"><button class="icon" title="Sign out" aria-label="Sign out">&#x21aa;</button></form><details class="mobile-menu"><summary title="Open navigation" aria-label="Open navigation"><span></span><span></span><span></span></summary><nav><a href="/plan">Plan the Run</a><a href="/history">Calculated Runs</a><a href="/trends">Avoid trends</a><a href="/password">Change password</a>{% if role in ['admin','superadmin'] %}<a href="/settings">Settings</a><a href="/users">Users</a>{% endif %}<form method="post" action="/logout"><input type="hidden" name="_token" value="{{ csrf }}"><button type="submit">Log Out</button></form></nav></details></header>{% endif %}
<main>{% if notice %}<p class="alert">{{ notice }}</p>{% endif %}{% if advisory %}<p class="advisory">{{ advisory }}</p>{% endif %}{% block content %}{% endblock %}</main><footer><a href="https://775drive.com" target="_blank" rel="noopener noreferrer">Developed by 775Drive.com</a></footer>{% block scripts %}{% endblock %}<script src="/assets/tables.js"></script></body></html>
