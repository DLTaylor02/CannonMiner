<!doctype html><html lang="en" data-theme="{{ theme|default('adaptive') }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{% block title %}CannonMiner{% endblock %}</title><link rel="stylesheet" href="/assets/app.css"><link rel="stylesheet" href="/assets/theme.css"><link rel="stylesheet" href="/assets/progress.css"><link rel="stylesheet" href="/assets/admin.css"></head><body>
{% if user %}<header><a class="brand" href="/">CannonMiner</a><nav><a href="/">Route explorer</a><a href="/history">Run history</a><a href="/trends">Avoid trends</a>{% if role in ['admin','superadmin'] %}<a href="/settings">Settings</a><a href="/users">Users</a>{% endif %}</nav><form method="post" action="/theme"><input type="hidden" name="_token" value="{{ csrf }}"><select name="theme" aria-label="Theme" onchange="this.form.submit()"><option value="adaptive" {{ theme=='adaptive'?'selected':'' }}>Adaptive</option><option value="light" {{ theme=='light'?'selected':'' }}>Light</option><option value="dark" {{ theme=='dark'?'selected':'' }}>Dark</option></select></form><form method="post" action="/logout"><input type="hidden" name="_token" value="{{ csrf }}"><button class="icon" title="Sign out" aria-label="Sign out">&#x21aa;</button></form></header>{% endif %}
<main>{% block content %}{% endblock %}</main></body></html>
