<!doctype html><html lang="en" data-theme="{{ theme|default('adaptive') }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{% block title %}CannonMiner{% endblock %}</title><link rel="stylesheet" href="/assets/app.css"><link rel="stylesheet" href="/assets/theme.css"><link rel="stylesheet" href="/assets/progress.css"><link rel="stylesheet" href="/assets/admin.css"><link rel="stylesheet" href="/assets/simulator.css"></head><body>
{% if user %}<header><a class="brand" href="/">CannonMiner</a><form class="theme-form" method="post" action="/theme"><input type="hidden" name="_token" value="{{ csrf }}"><select name="theme" aria-label="Theme" onchange="this.form.submit()"><option value="adaptive" {{ theme=='adaptive'?'selected':'' }}>Adaptive</option><option value="light" {{ theme=='light'?'selected':'' }}>Light</option><option value="dark" {{ theme=='dark'?'selected':'' }}>Dark</option></select></form><details class="mobile-menu"><summary title="Open navigation" aria-label="Open navigation"><span></span><span></span><span></span></summary><nav><a href="/analyze-traffic">Analyze Traffic</a><a href="/history">Historical Analysis</a><a href="/calendar">Calendar</a><a href="/plan">Plan the Run</a><a href="/run-windows">Run Windows</a><a href="/tools">Tools</a><a class="simulator-nav" href="/simulator">CannonBall Trail+</a><a href="/settings">Settings</a>{% if role in ['admin','superadmin'] %}<a href="/users">Users</a>{% endif %}<form method="post" action="/logout"><input type="hidden" name="_token" value="{{ csrf }}"><button type="submit">Log Out</button></form></nav></details></header>{% endif %}
<main>{% if notice %}<p class="alert">{{ notice }}</p>{% endif %}{% if advisory %}<p class="advisory">{{ advisory }}</p>{% endif %}{% block content %}{% endblock %}</main><footer><a href="https://775drive.com" target="_blank" rel="noopener noreferrer">Developed by 775Drive.com</a></footer>{% block scripts %}{% endblock %}<script src="/assets/tables.js"></script></body></html>
