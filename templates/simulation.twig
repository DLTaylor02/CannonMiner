{% extends 'layout.twig' %}{% block title %}Simulation | CannonMiner{% endblock %}{% block body_class %}simulation-page{% endblock %}{% block content %}
<section class="page-head simulator-head"><div><p class="kicker">CannonBall Trail+</p><div class="simulation-title"><h1>Live Simulation</h1><button id="pause-action" type="button"{% if not can_control %} disabled{% endif %}>Pause</button></div></div><div class="simulation-clock"><strong id="simulation-status">{{ simulation.status|replace({'_':' '})|title }}</strong><time id="simulation-time">Loading...</time></div></section>
<div id="simulation-error" class="alert" hidden></div>
<div class="simulation-grid"><section class="simulator-map-panel"><div class="simulator-location"><div class="simulation-location-row"><button id="map-segment-previous" type="button" aria-label="View previous segment" title="Previous segment" disabled>&larr;</button><strong id="simulation-location">Redball Garage, NY</strong><button id="map-segment-next" type="button" aria-label="View next segment" title="Next segment" disabled>&rarr;</button></div><span id="simulation-traffic"></span></div><div class="simulation-map-stage"><canvas id="simulation-map" width="1000" height="520" aria-label="Current position along active route segment"></canvas><canvas id="fuel-minigame" width="1000" height="520" aria-label="Interactive fuel stop" hidden></canvas><canvas id="tire-minigame" width="1000" height="520" aria-label="Interactive flat tire repair" hidden></canvas></div><div class="simulation-map-status"><span id="simulation-weather" class="simulation-status-icon" hidden></span><span id="simulation-traffic-icon" class="simulation-status-icon" hidden>🚦</span><span id="simulation-vehicle-limit" class="simulation-status-icon" hidden>🚘</span></div></section>
<section class="simulator-instruments"><div class="instrument instrument-vehicle"><div class="instrument-vehicle-image"><img id="sim-vehicle-image" alt="" hidden><span id="sim-vehicle-fallback" aria-hidden="true">&#x1f697;</span></div><div><span>Vehicle</span><strong id="sim-vehicle-name">-</strong></div></div><div class="instrument"><span>Speed</span><strong id="sim-speed">0 mph</strong></div><div class="instrument"><span>Fuel</span><strong id="sim-fuel">-</strong><div><i id="sim-fuel-bar"></i></div></div><div class="instrument"><span>Elapsed</span><strong id="sim-elapsed">0h 0m 0s</strong></div><div class="instrument"><span>Distance</span><strong id="sim-distance">0 mi</strong></div><div class="instrument"><span>Target</span><strong id="sim-target">-</strong></div><div class="instrument"><span>Equipment</span><strong id="sim-equipment" class="instrument-equipment">None</strong></div></section>
<section class="outlined-section simulation-controls"><div class="section-heading"><div><p class="kicker">Controls</p></div></div><label>Target speed (mph)<input id="speed-control" name="speed" type="text" inputmode="numeric" pattern="[0-9]{2,3}" maxlength="3" autocomplete="off" spellcheck="false" aria-describedby="speed-control-note"{% if not can_control %} disabled{% endif %}></label><div class="simulation-actions"><button id="driver-action" type="button"{% if not can_control %} disabled{% endif %}>Change driver</button><button id="fuel-action" type="button"{% if not can_control %} disabled{% endif %}>Stop for fuel</button><button id="consumable-action" type="button"{% if not can_control %} disabled{% endif %}>Use item</button></div>{% if is_superadmin %}<div class="simulation-debug-actions"><span>Test events</span><button id="debug-flat-tire" type="button">Flat tire</button></div>{% endif %}<label>Co-pilot<select id="copilot-control" name="copilot"{% if not can_control %} disabled{% endif %}><option value="">None</option></select></label><p id="speed-control-note" class="control-note">{% if can_control %}Speed changes apply after a brief typing pause. Co-pilot changes apply immediately. Driver changes bring the vehicle to a controlled stop.{% else %}Watching {{ simulation.username }}'s simulation. Only the owner can operate the controls and answer decisions.{% endif %}</p></section>
<section class="outlined-section simulation-crew"><div class="section-heading"><div><p class="kicker">Crew</p></div></div><div id="driver-cards"></div></section>
<section id="simulation-summary" class="outlined-section simulation-summary" hidden><div class="section-heading"><div><p class="kicker">Final report</p><h2>Run summary</h2></div><a class="summary-close history-delete" href="/simulator" aria-label="Return to simulator lobby" title="Return to lobby">X</a></div><p id="summary-reason"></p><div class="metrics summary-primary-metrics"><div><strong id="summary-time">--</strong><span>Elapsed</span></div><div><strong id="summary-average">--</strong><span>Average speed</span></div></div><div class="summary-timeline"><div><span>Departed New York</span><time id="summary-departure">--</time></div><div><span>Run ended</span><time id="summary-ended">--</time></div></div><div id="summary-record" class="summary-record" hidden><strong>You beat the record!</strong><span>You and your crew will be remembered in the history books for your skill and bravery</span></div><div class="summary-loadout"><div class="summary-car-equipment"><div class="summary-vehicle"><div class="instrument-vehicle-image"><img id="summary-car-image" width="128" height="128" alt="" hidden><span id="summary-car-fallback" aria-hidden="true">&#x1f697;</span></div><div><p class="kicker">Vehicle</p><strong id="summary-car">--</strong></div></div><div class="summary-equipment"><p class="kicker">Equipment</p><ul id="summary-equipment"><li>None</li></ul></div></div><div class="summary-crew"><p class="kicker">Crew</p><div id="summary-drivers" class="summary-drivers"></div></div></div><canvas id="summary-route-map" width="1200" height="360" aria-label="Complete route traveled with speed, stop, and obstacle history"></canvas><div class="speed-map-key"><span>0 mph</span><i></i><span>Target speed</span><b>&#x21c4; Driver</b><b>&#x26fd; Fuel</b><b>&#x1f634; Roadside rest</b><b>&#x1f6a6; Observed traffic</b><b>&#x1f68c; Traffic obstruction</b><b>&#x1f693; Police</b><b>&#x1f4a5; Crash</b><b>&#x1f98c; Wildlife</b><b>&#x26ab; Flat tire</b><b>&#x1f527; Mechanical</b><b>&#x1f6a7; Road</b><b>&#x2705; Response</b><b>&#x1f32b;&#xfe0f; &#x1f327;&#xfe0f; &#x1f9ca; &#x1f328;&#xfe0f; Weather</b><b>&#x1f4a8; Tail wind</b><b>&#x1f32c;&#xfe0f; Head wind</b></div><div class="metrics summary-run-metrics"><div><strong id="summary-distance">--</strong><span>Distance</span></div><div><strong id="summary-fuel-stops">--</strong><span>Fuel stops</span></div><div><strong id="summary-mpg">--</strong><span>MPG</span></div><div><strong id="summary-police-encounters">--</strong><span>Police encounters</span></div><div><strong id="summary-stops">--</strong><span>Total time stopped</span></div><div><strong id="summary-fuel">--</strong><span>Fuel remaining</span></div></div><div class="summary-return"><button id="print-summary" class="simulator-primary" type="button">Print summary</button><a class="simulator-primary" href="/simulator">Return to lobby</a></div></section></div>
<section class="outlined-section simulation-log simulation-log-below"><div class="section-heading"><div><p class="kicker">Event queue</p><h2>Run history</h2></div></div><ol id="event-log"></ol></section>
<dialog id="simulation-decision"><div class="decision-heading"><p class="kicker" id="decision-kicker">Decision required</p><h2 id="decision-title">Choose an action</h2></div><p id="decision-copy"></p><div id="decision-options" class="decision-options"></div></dialog>
<dialog id="consumable-dialog"><div class="decision-heading"><p class="kicker">Crew supplies</p><h2>Use an item</h2></div><p>Choose an item and the crew member who will use it.</p><div id="consumable-options" class="consumable-options"></div><div class="decision-options"><button id="consumable-cancel" class="decision-cancel" type="button">Cancel</button></div></dialog>
<script>window.CannonMinerSimulation={id:{{ simulation.id|json_encode|raw }},csrf:{{ csrf|json_encode|raw }},canControl:{{ can_control ? 'true' : 'false' }},isSuperadmin:{{ is_superadmin ? 'true' : 'false' }}};</script><script src="/assets/simulator.js"></script>
{% endblock %}
