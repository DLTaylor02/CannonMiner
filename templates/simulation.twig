{% extends 'layout.twig' %}{% block title %}Simulation | CannonMiner{% endblock %}{% block body_class %}simulation-page{% endblock %}{% block content %}
<section class="page-head simulator-head"><div><p class="kicker">CannonBall Trail+</p><div class="simulation-title"><h1>Live Simulation</h1><button id="pause-action" type="button">Pause</button></div><small>Desktop-oriented simulator interface</small></div><div class="simulation-clock"><strong id="simulation-status">{{ simulation.status|replace({'_':' '})|title }}</strong><time id="simulation-time">Loading...</time></div></section>
<div id="simulation-error" class="alert" hidden></div>
<div class="simulation-grid"><section class="simulator-map-panel"><canvas id="simulation-map" width="1000" height="520" aria-label="Current position along active route segment"></canvas><div class="simulation-map-status"><span id="simulation-weather" class="simulation-status-icon" hidden></span><span id="simulation-traffic-icon" class="simulation-status-icon" hidden>🚦</span></div><div class="simulator-location"><strong id="simulation-location">Redball Garage, NY</strong><span id="simulation-traffic"></span></div></section>
<section class="simulator-instruments"><div class="instrument"><span>Speed</span><strong id="sim-speed">0 mph</strong></div><div class="instrument"><span>Fuel</span><strong id="sim-fuel">-</strong><div><i id="sim-fuel-bar"></i></div></div><div class="instrument"><span>Elapsed</span><strong id="sim-elapsed">0h 0m 0s</strong></div><div class="instrument"><span>Distance</span><strong id="sim-distance">0 mi</strong></div><div class="instrument"><span>Target</span><strong id="sim-target">-</strong></div></section>
<section class="outlined-section simulation-controls"><div class="section-heading"><div><p class="kicker">Decisions</p><h2>Run controls</h2></div></div><form id="speed-control"><label>Target average speed (mph)<input name="speed" type="number" min="20" max="250" step="1"></label><button>Set target</button></form><div class="simulation-actions"><button id="driver-action" type="button">Change driver</button><button id="fuel-action" type="button">Stop for fuel</button></div><label>Co-pilot<select id="copilot-control" name="copilot"><option value="">None</option></select></label><p class="control-note">Co-pilot changes apply immediately. Driver changes bring the vehicle to a controlled stop.</p></section>
<section class="outlined-section simulation-crew"><div class="section-heading"><div><p class="kicker">Roster</p><h2>Driver condition</h2></div></div><div id="driver-cards"></div></section>
<section id="simulation-summary" class="outlined-section simulation-summary" hidden><div class="section-heading"><div><p class="kicker">Final report</p><h2>Run summary</h2></div></div><div class="metrics"><div><strong id="summary-time">--</strong><span>Elapsed</span></div><div><strong id="summary-average">--</strong><span>Average speed</span></div><div><strong id="summary-distance">--</strong><span>Distance</span></div><div><strong id="summary-stops">--</strong><span>Stopped</span></div><div><strong id="summary-fuel">--</strong><span>Fuel remaining</span></div></div><p id="summary-reason"></p><p id="summary-route"></p><div class="summary-return"><a class="simulator-primary" href="/simulator">Return to lobby</a></div></section></div>
<section class="outlined-section simulation-log simulation-log-below"><div class="section-heading"><div><p class="kicker">Event queue</p><h2>Run history</h2></div></div><ol id="event-log"></ol></section>
<dialog id="simulation-decision"><div class="decision-heading"><p class="kicker" id="decision-kicker">Decision required</p><h2 id="decision-title">Choose an action</h2></div><p id="decision-copy"></p><div id="decision-options" class="decision-options"></div></dialog>
<script>window.CannonMinerSimulation={id:{{ simulation.id|json_encode|raw }},csrf:{{ csrf|json_encode|raw }}};</script><script src="/assets/simulator.js"></script>
{% endblock %}
