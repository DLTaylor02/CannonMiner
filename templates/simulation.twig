{% extends 'layout.twig' %}{% block title %}Simulation | CannonMiner{% endblock %}{% block content %}
<section class="page-head simulator-head"><div><p class="kicker">CannonBall Trail+</p><h1>Live Simulation</h1></div><div class="simulation-clock"><strong id="simulation-status">{{ simulation.status|replace({'_':' '})|title }}</strong><time id="simulation-time">Loading...</time></div></section>
<div id="simulation-error" class="alert" hidden></div>
<div class="simulation-grid"><section class="simulator-map-panel"><canvas id="simulation-map" width="1000" height="520" aria-label="Current position along active route segment"></canvas><div class="simulator-location"><strong id="simulation-location">Red Ball</strong><span id="simulation-traffic"></span></div></section>
<section class="simulator-instruments"><div class="instrument"><span>Speed</span><strong id="sim-speed">0 mph</strong></div><div class="instrument"><span>Fuel</span><strong id="sim-fuel">-</strong><div><i id="sim-fuel-bar"></i></div></div><div class="instrument"><span>Distance</span><strong id="sim-distance">0 mi</strong></div><div class="instrument"><span>Target</span><strong id="sim-target">-</strong></div></section>
<section class="outlined-section simulation-controls"><div class="section-heading"><div><p class="kicker">Decisions</p><h2>Run controls</h2></div></div><div id="route-choices" class="route-choices"></div><form id="speed-control"><label>Target average speed (mph)<input name="speed" type="number" min="20" max="250" step="1"></label><button>Set target</button></form><div class="simulation-actions"><button id="pause-action" type="button">Pause</button><button id="fuel-action" type="button">Stop for fuel</button></div><form id="role-control"><label>Driver<select name="driver"></select></label><label>Co-pilot<select name="copilot"><option value="">None</option></select></label><button>Assign roles</button></form><p class="control-note">Pause before changing the driver. Rest and co-pilot roles may be reassigned while stopped.</p></section>
<section class="outlined-section simulation-crew"><div class="section-heading"><div><p class="kicker">Roster</p><h2>Driver condition</h2></div></div><div id="driver-cards"></div></section>
<section class="outlined-section simulation-log"><div class="section-heading"><div><p class="kicker">Event queue</p><h2>Run history</h2></div></div><ol id="event-log"></ol></section>
<section id="simulation-summary" class="outlined-section simulation-summary simulation-log" hidden><div class="section-heading"><div><p class="kicker">Final report</p><h2>Run summary</h2></div></div><div class="metrics"><div><strong id="summary-time">--</strong><span>Elapsed</span></div><div><strong id="summary-distance">--</strong><span>Distance</span></div><div><strong id="summary-stops">--</strong><span>Stopped</span></div><div><strong id="summary-fuel">--</strong><span>Fuel remaining</span></div></div><p id="summary-route"></p></section></div>
<script>window.CannonMinerSimulation={id:{{ simulation.id|json_encode|raw }},csrf:{{ csrf|json_encode|raw }}};</script><script src="/assets/simulator.js"></script>
{% endblock %}
