{% extends 'layout.twig' %}{% block title %}Sign in | CannonMiner{% endblock %}{% block content %}
<section class="login"><div><p class="kicker">Traffic intelligence</p><h1>CannonMiner</h1><p>Risk-aware route and departure planning from real traffic observations.</p></div>
<form method="post" class="panel"><h2>Sign in</h2>{% if error %}<p class="alert">{{ error }}</p>{% endif %}<label>Username<input name="username" autocomplete="username" required autofocus></label><label>Password<input type="password" name="password" autocomplete="current-password" required></label><button>Sign in</button></form></section>
{% endblock %}
