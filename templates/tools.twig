{% extends 'layout.twig' %}{% block title %}Tools | CannonMiner{% endblock %}{% block content %}
<section class="page-head"><div><p class="kicker">Utilities</p><h1>Tools</h1></div><p>Supporting calculations for planning and evaluating a run.</p></section>
<div class="tools-stack"><section class="outlined-section"><div class="section-heading"><div><p class="kicker">Speed planning</p><h2>Cruising Speed Calculator</h2></div><p>Account for fuel service and speed transitions when setting a target average.</p></div>
{% if routes %}<div class="tool-layout"><form id="cruise-calculator" class="tool-form">
<fieldset><legend>Run</legend><label>Route<select name="route" data-shared-route>{% for route in routes %}<option value="{{ route.label }}" data-distance="{{ route.distance_miles }}" {{ route.label==selected_route?'selected':'' }}>{{ route.label }}</option>{% endfor %}</select></label><label>Target average speed (mph)<input name="average" data-shared-speed type="number" min="1" max="500" step="0.1" value="{{ target_speed }}"></label></fieldset>
<fieldset><legend>Vehicle</legend><label>Fuel capacity <span>gallons</span><input name="capacity" type="number" min="0.1" max="500" step="0.1" value="20"></label><label>Estimated MPG at cruising speed<input name="mpg" type="number" min="0.1" max="200" step="0.1" value="20"></label></fieldset>
</form><section class="tool-output" aria-live="polite"><p class="kicker">Required pace</p><strong id="cruise-speed">-</strong><span>cruising speed</span><div class="tool-metrics"><div><strong id="route-distance">-</strong><span>route distance</span></div><div><strong id="fuel-required">-</strong><span>fuel consumed</span></div><div><strong id="fuel-stops">-</strong><span>fill-ups</span></div><div><strong id="fuel-dispensed">-</strong><span>fuel dispensed</span></div><div><strong id="stopped-time">-</strong><span>fully stopped</span></div><div><strong id="transition-time">-</strong><span>accelerating / decelerating</span></div><div><strong id="target-time">-</strong><span>target total time</span></div></div><p id="calculator-error" class="danger" hidden></p><div class="formula"><span>Formula</span><code id="cruise-formula">D / V + K x V + S = D / A</code></div></section></div>{% else %}<p class="alert">Collect segment measurements before using the cruising speed calculator.</p>{% endif %}
</section>
{% if routes %}<section class="outlined-section"><div class="section-heading"><div><p class="kicker">Recurring conditions</p><h2>Departure Window Heatmap</h2></div><p>Compare supported weekday and departure-hour patterns for a complete route.</p></div>
<div class="heatmap-controls"><label>Route<select data-shared-route>{% for route in routes %}<option value="{{ route.label }}" {{ route.label==selected_route?'selected':'' }}>{{ route.label }}</option>{% endfor %}</select></label><label>Target average speed (mph)<input data-shared-speed type="number" min="1" max="500" step="0.1" value="{{ target_speed }}"></label><label>Cell color<select id="heatmap-metric"><option value="expected_seconds">Expected time</option><option value="risk">Risk</option><option value="p90_seconds">90th-percentile duration</option></select></label></div>
<div id="departure-heatmap" class="departure-heatmap" aria-live="polite"><p class="tool-loading"><img class="queue-spinner" src="/assets/refresh.webp" width="24" height="24" alt="">Calculating supported departure windows...</p></div><div class="heatmap-scale" hidden><span>Lower</span><i></i><span>Higher</span></div><p id="heatmap-error" class="alert" hidden></p></section>
<section class="outlined-section"><div class="section-heading"><div><p class="kicker">Strategy tradeoffs</p><h2>Route Comparison</h2></div><p>Compare speed, delay risk, and observation confidence across every complete route.</p></div>
<div class="comparison-controls"><label>Highlighted route<select data-shared-route>{% for route in routes %}<option value="{{ route.label }}" {{ route.label==selected_route?'selected':'' }}>{{ route.label }}</option>{% endfor %}</select></label><label>Target average speed (mph)<input data-shared-speed type="number" min="1" max="500" step="0.1" value="{{ target_speed }}"></label></div>
<div id="route-comparison" class="route-comparison" aria-live="polite"><p class="tool-loading"><img class="queue-spinner" src="/assets/refresh.webp" width="24" height="24" alt="">Comparing complete routes...</p></div><div id="comparison-list" class="comparison-list"></div><p id="comparison-error" class="alert" hidden></p></section>{% endif %}</div>
{% endblock %}{% block scripts %}{% if routes %}<script src="/assets/tools.js"></script>{% endif %}{% endblock %}
