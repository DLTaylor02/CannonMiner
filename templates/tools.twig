{% extends 'layout.twig' %}{% block title %}Tools | CannonMiner{% endblock %}{% block content %}
<section class="page-head"><div><p class="kicker">Planning utility</p><h1>Cruising Speed Calculator</h1></div><p>Account for fuel service and speed transitions when setting a target average.</p></section>
{% if routes %}<div class="tool-layout"><form id="cruise-calculator" class="tool-form">
<fieldset><legend>Run</legend><label>Route<select name="route">{% for route in routes %}<option value="{{ route.label }}" data-distance="{{ route.distance_miles }}" {{ route.label==selected_route?'selected':'' }}>{{ route.label }}</option>{% endfor %}</select></label><label>Target average speed <span>mph</span><input name="average" type="number" min="1" max="500" step="0.1" value="{{ target_speed }}"></label></fieldset>
<fieldset><legend>Vehicle</legend><label>Fuel capacity <span>gallons</span><input name="capacity" type="number" min="0.1" max="500" step="0.1" value="20"></label><label>Estimated MPG at cruising speed<input name="mpg" type="number" min="0.1" max="200" step="0.1" value="20"></label></fieldset>
<fieldset><legend>Speed transitions</legend><label>Acceleration <span>mph per second</span><input name="acceleration" type="number" min="0.1" max="20" step="0.1" value="3"></label><label>Deceleration <span>mph per second</span><input name="deceleration" type="number" min="0.1" max="20" step="0.1" value="4"></label></fieldset>
</form><section class="tool-output" aria-live="polite"><p class="kicker">Required pace</p><strong id="cruise-speed">-</strong><span>cruising speed</span><div class="tool-metrics"><div><strong id="route-distance">-</strong><span>route distance</span></div><div><strong id="fuel-required">-</strong><span>fuel consumed</span></div><div><strong id="fuel-stops">-</strong><span>fill-ups</span></div><div><strong id="fuel-dispensed">-</strong><span>fuel dispensed</span></div><div><strong id="stopped-time">-</strong><span>fully stopped</span></div><div><strong id="transition-time">-</strong><span>accelerating / decelerating</span></div><div><strong id="target-time">-</strong><span>target total time</span></div></div><p id="calculator-error" class="danger" hidden></p><div class="formula"><span>Formula</span><code id="cruise-formula">D / V + K x V + S = D / A</code></div></section></div>{% else %}<p class="alert">Collect segment measurements before using the cruising speed calculator.</p>{% endif %}
{% endblock %}{% block scripts %}{% if routes %}<script src="/assets/tools.js"></script>{% endif %}{% endblock %}
