{% extends 'layout.twig' %}{% block title %}Projected Run | CannonMiner{% endblock %}{% block content %}
<section class="page-head"><div><p class="kicker">Future projection</p><h1>Planning run</h1></div><button id="plan-print" class="print-button" type="button" onclick="window.print()" hidden>Print</button></section>
<div id="planning-progress" class="panel"><strong id="planning-stage">{{ job.stage }}</strong><p id="planning-queue" class="progress-note" hidden></p><div class="progress-track"><div id="planning-bar" class="progress-bar"></div></div><p id="planning-percent">0%</p></div><div id="planning-error" class="alert" hidden></div><div id="planning-results"></div>
<script>
const planningId={{ job.id|json_encode|raw }},escapePlan=value=>String(value).replace(/[&<>"']/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
const planTime=new Intl.DateTimeFormat('en-US',{timeZone:'America/New_York',weekday:'long',year:'numeric',month:'long',day:'numeric',hour:'numeric',minute:'2-digit',timeZoneName:'short'}),planBrowserTime=new Intl.DateTimeFormat(undefined,{year:'numeric',month:'short',day:'numeric',hour:'numeric',minute:'2-digit',timeZoneName:'short'});
const planDuration=seconds=>{const minutes=Math.round(Number(seconds)/60);return `${Math.floor(minutes/60)} hr ${String(minutes%60).padStart(2,'0')} min`};
const planSegmentFormatters=new Map(),planSegmentName=name=>String(name).replace('_to_',' to ');
function planSegmentStart(segment){if(!segment.start_time||!segment.start_timezone)return '-';try{if(!planSegmentFormatters.has(segment.start_timezone))planSegmentFormatters.set(segment.start_timezone,new Intl.DateTimeFormat('en-US',{timeZone:segment.start_timezone,weekday:'short',month:'short',day:'numeric',hour:'numeric',minute:'2-digit',timeZoneName:'short'}));return planSegmentFormatters.get(segment.start_timezone).format(new Date(segment.start_time))}catch{return '-'}}
function planRiskMarkup(item){const rows=(item.segment_risks||[]).map(segment=>`<tr><td data-label="Segment"><span class="segment-risk-name"><i style="--segment-color:#${escapePlan(segment.color)}"></i>${escapePlan(planSegmentName(segment.name))}</span></td><td data-label="Segment start">${escapePlan(planSegmentStart(segment))}</td><td data-label="Into run">${Number.isFinite(Number(segment.start_offset_seconds))?planDuration(segment.start_offset_seconds):'-'}</td><td data-label="Risk">${(Number(segment.risk)*100).toFixed(1)}%</td></tr>`).join('');return rows?`<div class="traffic-key"><span>Lower traffic likelihood</span><i class="traffic-scale"></i><span>Higher</span></div><div class="segment-risk-table"><table><thead><tr><th>Segment</th><th>Segment start</th><th>Into run</th><th>Risk</th></tr></thead><tbody>${rows}</tbody></table></div>`:''}
const planLabel=(value,index)=>({recommended:'Recommended projected run',day_alternative:'Different-day alternative',route_time_alternative:'Route/time alternative'}[value]||(index?'Alternative':'Recommended projected run'));
function renderPlan(items){document.querySelector('h1').textContent='Projected Runs';document.getElementById('planning-progress').hidden=true;document.getElementById('plan-print').hidden=false;document.getElementById('planning-results').innerHTML=items.map((item,index)=>`<article class="result projected-result"><div class="result-copy"><p class="rank">${planLabel(item.designation,index)}</p><h2>${escapePlan(item.route)}</h2><p class="departure">Projected departure: ${escapePlan(planTime.format(new Date(item.departure)))} (New York time)</p><div class="metrics"><div><strong>${planDuration(item.expected_seconds)}</strong><span>projected expected time</span></div><div><strong>${planDuration(item.upper_seconds)}</strong><span>likely upper duration</span></div><div><strong>${(item.risk*100).toFixed(1)}%</strong><span>projected risk</span></div><div><strong>${(item.confidence*100).toFixed(0)}%</strong><span>projection confidence</span></div><div><strong>${item.evidence_groups}</strong><span>distinct evidence groups</span></div><div><strong>${item.matches}</strong><span>matching calculations</span></div></div>${planRiskMarkup(item)}<p class="projection-source">Evidence current through ${planBrowserTime.format(new Date(item.latest_source_at))}. <a href="/analysis/${encodeURIComponent(item.source_id)}#result-${item.source_index}">View latest source calculation</a></p><a class="result-tool-link" href="/tools?route=${encodeURIComponent(item.route)}&amp;speed=${encodeURIComponent(item.target_speed_mph)}">Use in cruising speed calculator</a>${item.within_risk_limit?'':'<p class="alert">No candidate met the requested risk limit; this is the best supported fallback.</p>'}</div>${item.map_available?`<img class="route-map" alt="Traffic-colored projected route map" src="/analysis/${encodeURIComponent(item.source_id)}/map/${item.source_index}">`:'<div class="map-unavailable">No stored route geometry is available for this source calculation.</div>'}</article>`).join('')}
async function pollPlan(){const response=await fetch(`/plan/${planningId}/status`,{cache:'no-store'}),job=await response.json(),percent=Math.round(100*job.progress_current/Math.max(1,job.progress_total));document.getElementById('planning-stage').textContent=job.stage;document.getElementById('planning-percent').textContent=percent+'%';document.getElementById('planning-bar').style.width=percent+'%';const queue=document.getElementById('planning-queue');if(job.status==='queued'){queue.hidden=false;queue.textContent=`Position ${job.queue_position} of ${job.queue_total} in the planning queue.`}else queue.hidden=true;if(job.status==='complete')return renderPlan(typeof job.result==='string'?JSON.parse(job.result):job.result);if(job.status==='failed'){document.getElementById('planning-error').hidden=false;document.getElementById('planning-error').textContent=job.error;return}setTimeout(pollPlan,1000)}pollPlan();
</script>{% endblock %}
