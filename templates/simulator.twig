{% extends 'layout.twig' %}{% macro simulation_row(simulation,csrf) %}<article class="simulation-row"><a href="/simulator/{{ simulation.id }}"><div><strong>{{ simulation.route_label ?: 'Redball Garage, NY departure' }}</strong><span>{{ simulation.mode|title }} | {{ simulation.state.traffic_mode|title }} traffic | {{ simulation.username }}</span></div><div>{% if simulation.successful and simulation.elapsed_label is defined %}<strong class="simulation-finish-time">{% if simulation.record|default(false) %}<span class="simulation-record-star" aria-label="Record beaten" title="Record beaten">&#x2b50;</span>{% endif %}{{ simulation.elapsed_label }}</strong><span>Portofino finish</span>{% else %}<strong>{{ simulation.status|replace({'_':' '})|title }}</strong><time class="browser-time" datetime="{{ simulation.simulated_at|date('c') }}">{{ simulation.simulated_at|date('Y-m-d H:i T') }}</time>{% endif %}</div></a>{% if simulation.can_delete %}<form method="post" action="/simulator/{{ simulation.id }}/delete" onsubmit="return confirm('Delete this simulation and its complete event history?')"><input type="hidden" name="_token" value="{{ csrf }}"><button class="history-delete" type="submit" aria-label="Delete simulation" title="Delete simulation">X</button></form>{% endif %}</article>{% endmacro %}{% block title %}CannonBall Trail+ | CannonMiner{% endblock %}{% block content %}
<section class="page-head simulator-head"><div><p class="kicker">Simulator mode</p><h1>CannonBall Trail+</h1></div><a class="simulator-primary" href="/simulator/new">Start new simulation</a></section>
<div class="simulator-lobby-sections"><section class="outlined-section"><div class="section-heading"><div><p class="kicker">On the road</p></div></div><div class="simulation-list">{% for simulation in active_simulations %}{{ _self.simulation_row(simulation,csrf) }}{% else %}<p class="simulator-empty">No simulations are currently in progress.</p>{% endfor %}</div></section>
<section class="outlined-section"><div class="section-heading"><div><p class="kicker">Saved games</p></div></div><div class="simulation-list">{% for simulation in completed_simulations %}{{ _self.simulation_row(simulation,csrf) }}{% else %}<p class="simulator-empty">No crew has reached Portofino yet.</p>{% endfor %}</div>{% if failed_simulations %}<div class="simulation-failed-heading"><p class="kicker">Runs ended early</p></div><div class="simulation-list">{% for simulation in failed_simulations %}{{ _self.simulation_row(simulation,csrf) }}{% endfor %}</div>{% endif %}</section></div>
<script>const simulatorTime=new Intl.DateTimeFormat(undefined,{year:'numeric',month:'short',day:'numeric',hour:'numeric',minute:'2-digit',timeZoneName:'short'});document.querySelectorAll('.browser-time').forEach(item=>item.textContent=simulatorTime.format(new Date(item.dateTime)));</script>
{% endblock %}
