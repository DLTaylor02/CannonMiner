{% extends 'layout.twig' %}{% block title %}Plan the Run | CannonMiner{% endblock %}{% block content %}
<section class="page-head"><div><p class="kicker">Future projection</p><h1>Plan the Run</h1></div><p>Project supported historical calculation patterns across the full day in 15-minute increments.</p></section>
{% if error %}<p class="alert">{{ error }}</p>{% endif %}{% if not planning_speeds %}<p class="alert">No current historical calculations are available yet. Run Analyze Traffic before building a future projection.</p>{% endif %}<form method="post" class="route-form planning-form"><input type="hidden" name="_token" value="{{ csrf }}"><label>Earliest date<input type="date" name="start_date" value="{{ input.start_date }}" required></label><label>Latest date<input type="date" name="end_date" value="{{ input.end_date }}" required></label><label>Target speed <span>mph</span><select name="speed" required>{% for speed in planning_speeds %}<option value="{{ speed }}" {{ input.speed == speed ? 'selected' : '' }}>{{ speed|number_format(1) }} mph</option>{% endfor %}</select></label><label>Strategy<select name="profile"><option value="balanced" {{ input.profile=='balanced'?'selected':'' }}>Balanced</option><option value="fastest" {{ input.profile=='fastest'?'selected':'' }}>Fastest</option><option value="reliability" {{ input.profile=='reliability'?'selected':'' }}>Reliability</option></select></label>{% if role in ['admin','superadmin'] %}<label>Maximum risk <span>percent</span><input type="number" name="risk" min="0" max="100" value="{{ input.risk }}"></label>{% endif %}<button {{ not planning_speeds ? 'disabled' : '' }}>Build projection</button></form>
{% include 'run-windows.twig' %}
{% endblock %}
